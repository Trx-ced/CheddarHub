		GasBoostVelocityCapBypass = 25,
		ReelingVelocityCapBypass = 12,
		VelocityCapsByAcceleration = {295, 295, 295, 295, 295},
	}

	local function cloneTable(value)
		if typeof(value) ~= "table" then
			return value
		end

		local copy = {}
		for key, item in pairs(value) do
			copy[key] = cloneTable(item)
		end
		return copy
	end

	local function loadConfig()
		if gearConfig then
			return gearConfig
		end

		local clientModules = ReplicatedStorage:FindFirstChild("Client_Modules")
		local gearClient = clientModules and clientModules:FindFirstChild("GearClient")
		local gearModule = gearClient and gearClient:FindFirstChild("GearConfig")
		if not gearModule then
			return nil
		end

		local ok, config = pcall(require, gearModule)
		if not ok or type(config) ~= "table" then
			return nil
		end

		gearConfig = config
		if type(config.GEN2) == "table" and not originalGen2 then
			originalGen2 = cloneTable(config.GEN2)
		end
		return gearConfig
	end

	function GearRuntime.GetDefaultGen2()
		return defaultGen2
	end

	function GearRuntime.Apply(values)
		local config = loadConfig()
		if not config or type(config.GEN2) ~= "table" then
			return false
		end

		local source = State.GearConfigEnabled and values or originalGen2
		if type(source) ~= "table" then
			return false
		end

		for key, value in pairs(source) do
			config.GEN2[key] = cloneTable(value)
		end

		return true
	end
end

