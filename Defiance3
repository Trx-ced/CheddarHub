local AntiGrabRuntime = {}
do
	local GrabModule = require(ReplicatedStorage:WaitForChild("Client_Modules"):WaitForChild("GrabModuleClient"))
	local originalGrab = GrabModule.Grab
	local currentConnection = nil
	local patched = false

	local function disconnectLoop()
		if currentConnection then
			currentConnection:Disconnect()
			currentConnection = nil
		end
	end

	local function antiGrabLoop(character)
		disconnectLoop()
		if not character then
			return
		end

		currentConnection = RunService.RenderStepped:Connect(function()
			if not State.AntiGrabV3Enabled then
				return
			end
			if not character or not character.Parent then
				return
			end

			local hum = character:FindFirstChild("Humanoid")
			local hrp = character:FindFirstChild("HumanoidRootPart")

			if character:HasTag("TitanGrabbed") then
				CollectionService:RemoveTag(character, "TitanGrabbed")
			end

			if not character:HasTag("EndGrab") then
				CollectionService:AddTag(character, "EndGrab")
			end

			if hrp and hrp.Anchored then
				hrp.Anchored = false
			end

			if hum then
				hum.AutoRotate = true
				hum.PlatformStand = false
			end
		end)
	end

	local function patchGrab()
		if patched then
			return
		end
		patched = true
		GrabModule.Grab = function(grabber, grabbed, offset, flip, duration)
			if State.AntiGrabV3Enabled and grabbed == player.Character then
				local char = player.Character
				if char then
					local hum = char:FindFirstChild("Humanoid")
					local hrp = char:FindFirstChild("HumanoidRootPart")

					if char:HasTag("TitanGrabbed") then
						CollectionService:RemoveTag(char, "TitanGrabbed")
					end

					if not char:HasTag("EndGrab") then
						CollectionService:AddTag(char, "EndGrab")
					end

					if hrp then
						hrp.Anchored = false
					end

					if hum then
						hum.AutoRotate = true
						hum.PlatformStand = false
						hum:ChangeState(Enum.HumanoidStateType.GettingUp)
					end
				end

				return
			end

			return originalGrab(grabber, grabbed, offset, flip, duration)
		end
	end

	local function restoreGrab()
		if patched then
			GrabModule.Grab = originalGrab
			patched = false
		end
	end

	track(player.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		antiGrabLoop(character)
	end))

	if player.Character then
		antiGrabLoop(player.Character)
	end

	function AntiGrabRuntime.Refresh()
		if State.AntiGrabV3Enabled then
			patchGrab()
			if player.Character then
				antiGrabLoop(player.Character)
			end
		else
			restoreGrab()
			disconnectLoop()
		end
	end

	function AntiGrabRuntime.Stop()
		restoreGrab()
		disconnectLoop()
	end
end

