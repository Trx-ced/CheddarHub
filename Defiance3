local function parseGearValue(key, text, fallback)
	if type(fallback) == "number" then
		return tonumber(text) or fallback
	end

	if type(fallback) == "table" then
		local values = {}
		for part in tostring(text):gmatch("[^,]+") do
			values[#values + 1] = tonumber(part) or 0
		end
		if #values == 0 then
			return fallback
		end
		return values
	end

	return tostring(text)
end

local function readGearValues()
	local defaults = GearRuntime.GetDefaultGen2()
	local values = {}
	for _, key in ipairs(gearOrder) do
		values[key] = parseGearValue(key, gearBoxes[key].Text, defaults[key])
	end
	return values
end

local function applyGearConfig()
	local values = readGearValues()
	GearRuntime.Apply(values)
end

