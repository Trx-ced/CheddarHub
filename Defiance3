local function pageNameFrom(object)
	while object do
		if pageNames[object] then
			return pageNames[object]
		end
		object = object.Parent
	end
	return activePage
end

local function trimText(text)
	return tostring(text or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
end

local function addSearchText(card, text)
	local record = cardRecords[card]
	if record then
		record.SearchText = trimText(record.SearchText .. " " .. tostring(text or ""))
	end
end

local function applyFeatureSearch()
	if applyingSearch or not searchBox then
		return
	end
	applyingSearch = true

	local query = trimText(searchBox.Text)
	if query == "" then
		for _, record in ipairs(searchRecords) do
			record.Card.Visible = true
		end
		for pageName, page in pairs(pages) do
			page.Visible = pageName == activePage
		end
		applyingSearch = false
		return
	end

	local firstPage
	for _, record in ipairs(searchRecords) do
		local matched = record.SearchText:find(query, 1, true) ~= nil
		record.Card.Visible = matched
		if matched and not firstPage then
			firstPage = record.PageName
		end
	end

	for pageName, page in pairs(pages) do
		page.Visible = pageName == firstPage
	end
	for tabName, btn in pairs(tabButtons) do
		local on = tabName == firstPage
		btn.BackgroundColor3 = on and Color3.fromRGB(31, 26, 47) or Color3.fromRGB(16, 16, 19)
		btn.TextColor3 = on and COL_TEXT or COL_SUB
	end
	applyingSearch = false
end

