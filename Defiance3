	})

	mk("TextLabel", {
		Parent = box,
		Position = UDim2.new(0, 18, 0, 12),
		Size = UDim2.new(1, -36, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COL_TEXT,
		Text = headerText,
	})

	local pageName = pageNameFrom(parent)
	local record = {
		Card = box,
		PageName = pageName,
		SearchText = trimText(headerText),
	}
	cardRecords[box] = record
	searchRecords[#searchRecords + 1] = record

	return box
end

