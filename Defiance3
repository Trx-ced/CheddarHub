local BlatantRuntime = {}
do
	local deleteToolConnections = {}

	local function disconnectDeleteToolConnections()
		for tool, conn in pairs(deleteToolConnections) do
			pcall(function()
				conn:Disconnect()
			end)
			deleteToolConnections[tool] = nil
		end
	end

	local function getVelocityMultiValue()
		local statistics = ReplicatedStorage:FindFirstChild("Statistics")
		if not statistics then return nil end
		local dmg = statistics:FindFirstChild("3DMG")
		if not dmg then return nil end
		return dmg:FindFirstChild("VelocityMulti")
	end

	local function applyVelocityMulti()
		local velocity = getVelocityMultiValue()
		if velocity and velocity:IsA("NumberValue") then
			velocity.Value = math.clamp(State.V7Value, 1, 10)
		elseif velocity and velocity:IsA("IntValue") then
			velocity.Value = math.floor(math.clamp(State.V7Value, 1, 10) + 0.5)
		end
	end

	local function applyDisableHandcutEffects()
		local sfx = ReplicatedStorage:FindFirstChild("SFX")
		if sfx then
			local tools = sfx:FindFirstChild("Tools")
			if tools then
				local sound = tools:FindFirstChild("HandCutter")
				if sound and sound:IsA("Sound") then
					sound.Volume = 0
					sound.Playing = false
				end
			end
		end

		local initializer = ReplicatedStorage:FindFirstChild("Initializer")
		if initializer then
			local effectsRoot = initializer:FindFirstChild("Effects")
			if effectsRoot then
				local handCutter = effectsRoot:FindFirstChild("HandCutter")
				if handCutter then
					local impact = handCutter:FindFirstChild("Impact")
					if impact then
						for _, v in ipairs(impact:GetDescendants()) do
							if v:IsA("ParticleEmitter") or v:IsA("Trail") then
								v.Enabled = false
							end
						end
					end

					local slashPart = handCutter:FindFirstChild("SlashPart")
					if slashPart then
						for _, v in ipairs(slashPart:GetDescendants()) do
							if v:IsA("ParticleEmitter") or v:IsA("Trail") then
								v.Enabled = false
							end
						end
					end
				end
			end
		end
	end

	local function deleteHandcutEffects()
		local sfxFolder = ReplicatedStorage:FindFirstChild("SFX")
		if sfxFolder then
			local tools = sfxFolder:FindFirstChild("Tools")
			if tools then
				local sound = tools:FindFirstChild("HandCutter")
				if sound then
					sound:Destroy()
				end
			end
		end

		local effects = ReplicatedStorage:FindFirstChild("Initializer")
		if effects then
			local effectsFolder = effects:FindFirstChild("Effects")
			if effectsFolder then
				local hc = effectsFolder:FindFirstChild("HandCutter")
				if hc then
					local impact = hc:FindFirstChild("Impact")
					if impact then
						impact:Destroy()
					end

					local slashPart = hc:FindFirstChild("SlashPart")
					if slashPart then
						local emitter = slashPart:FindFirstChild("ParticleEmitter")
						if emitter then emitter:Destroy() end
						local wind = slashPart:FindFirstChild("Wind")
						if wind then wind:Destroy() end
						local wind2 = slashPart:FindFirstChild("Wind2")
						if wind2 then wind2:Destroy() end
						local children = slashPart:GetChildren()
						if children[5] then children[5]:Destroy() end
						if children[4] then children[4]:Destroy() end
					end
				end
			end
		end
	end

	local function connectDeleteTool(tool)
		if not tool or not tool:IsA("Tool") or tool.Name ~= "HandCutter" then return end
		if deleteToolConnections[tool] then return end
		deleteToolConnections[tool] = tool.Activated:Connect(function()
			if State.HandcutDeleteEnabled then
				deleteHandcutEffects()
			end
		end)
		tool.AncestryChanged:Connect(function(_, parent)
			if parent == nil and deleteToolConnections[tool] then
				pcall(function()
					deleteToolConnections[tool]:Disconnect()
				end)
				deleteToolConnections[tool] = nil
			end
		end)
	end

	local function hookDeleteTools()
		if not State.HandcutDeleteEnabled then
			disconnectDeleteToolConnections()
			return
		end
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			for _, child in ipairs(backpack:GetChildren()) do
				connectDeleteTool(child)
			end
		end
		local char = player.Character
		if char then
			for _, child in ipairs(char:GetChildren()) do
				connectDeleteTool(child)
			end
		end
	end

	local function giveHandcutTool()
		local skillTools = ReplicatedStorage:FindFirstChild("SkillTools")
		if not skillTools then return end
		local skillTool = skillTools:FindFirstChild("HandCutter")
		if not skillTool then return end

		local backpack = player:FindFirstChild("Backpack") or player:WaitForChild("Backpack", 2)
		local character = player.Character or player.CharacterAdded:Wait()
		if not backpack or not character then return end

		if backpack:FindFirstChild(skillTool.Name) or character:FindFirstChild(skillTool.Name) then
			return
		end

		local clonedTool = skillTool:Clone()
		clonedTool.Parent = backpack
		if State.HandcutDeleteEnabled then
			connectDeleteTool(clonedTool)
		end
	end

	track(player.CharacterAdded:Connect(function()
		if unloaded then return end
		task.delay(0.5, function()
			if unloaded then return end
			hookDeleteTools()
			if State.GiveHandcutEnabled then
				giveHandcutTool()
			end
		end)
	end))

	track(player:WaitForChild("Backpack").ChildAdded:Connect(function(child)
		if unloaded then return end
		if State.HandcutDeleteEnabled then
			connectDeleteTool(child)
		end
	end))

	track(RunService.Heartbeat:Connect(function()
		if unloaded then return end
		if State.V7Enabled then
			applyVelocityMulti()
		end
		if State.HandcutDisableEnabled then
			applyDisableHandcutEffects()
		end
		if State.HandcutDeleteEnabled then
			hookDeleteTools()
		end
		if State.GiveHandcutEnabled then
			giveHandcutTool()
		end
	end))

	function BlatantRuntime.RefreshDeleteHooks()
		hookDeleteTools()
	end

	function BlatantRuntime.Stop()
		disconnectDeleteToolConnections()
	end
end

local HookRangeRuntime = {}
do
	local characterConnections = {}
	local currentCharacter = nil
	local updating = false

	local function disconnectCharacterConnections()
		for _, c in ipairs(characterConnections) do
			pcall(function()
				c:Disconnect()
			end)
		end
		table.clear(characterConnections)
	end

	local function getBaseMaxHook(character)
		local stored = character:GetAttribute("HookRangeBaseMaxHook")
		if typeof(stored) == "number" then
			return stored
		end

		local currentMaxHook = character:GetAttribute("MaxHook")
		if typeof(currentMaxHook) ~= "number" then
			return nil
		end

		character:SetAttribute("HookRangeBaseMaxHook", currentMaxHook)
		return currentMaxHook
	end

	local function updateMaxHook(character)
		if not character or updating then
			return
		end

		local base = getBaseMaxHook(character)
		if not base then
			return
		end

		updating = true
		if State.HookRangeExtenderEnabled then
			character:SetAttribute("MaxHook", State.HookRangeValue)
		else
			character:SetAttribute("MaxHook", base)
		end
		updating = false
	end

	local function applyToCharacter(character)
		disconnectCharacterConnections()
		currentCharacter = character
		if not character then
			return
		end

		getBaseMaxHook(character)
		updateMaxHook(character)
		table.insert(characterConnections, character:GetAttributeChangedSignal("MaxHook"):Connect(function()
			if updating then
				return
			end
			local currentMaxHook = character:GetAttribute("MaxHook")
			if typeof(currentMaxHook) == "number" and not State.HookRangeExtenderEnabled then
				character:SetAttribute("HookRangeBaseMaxHook", currentMaxHook)
			end
			updateMaxHook(character)
		end))
	end

	track(player.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		applyToCharacter(character)
	end))

	if player.Character then
		applyToCharacter(player.Character)
	end

	function HookRangeRuntime.Refresh()
		if player.Character and player.Character ~= currentCharacter then
			applyToCharacter(player.Character)
		elseif currentCharacter then
			updateMaxHook(currentCharacter)
		end
	end

	function HookRangeRuntime.Stop()
		if currentCharacter then
			State.HookRangeExtenderEnabled = false
			updateMaxHook(currentCharacter)
		end
		disconnectCharacterConnections()
	end
end

