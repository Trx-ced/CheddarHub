local Connections = {}

local function track(conn)
	table.insert(Connections, conn)
	return conn
end

local function disconnectAll()
	for _, conn in ipairs(Connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(Connections)
end

local function mk(className, props)
	local obj = Instance.new(className)
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	return obj
end

local function clamp(n, a, b)
	if n < a then return a end
	if n > b then return b end
	return n
end

local function planar(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function safeUnit(v)
	local m = v.Magnitude
	if m <= 1e-6 then
		return Vector3.zero
	end
	return v / m
end

local function lerpVec(a, b, t)
	return a + (b - a) * t
end

local function keyName(keyCode)
	local s = tostring(keyCode)
	return s:gsub("Enum.KeyCode.", "")
end

local function getLocalRoot()
	local character = player.Character
	if character then
		return character:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function findHumanoid(model)
	if not model or not model:IsA("Model") then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

local COLLISION_HITBOX_NAMES = {
	LeftFootCollision = true,
	LeftHandCollision = true,
	LeftLowerArmCollision = true,
	LeftLowerLegCollision = true,
	LeftUpperArmCollision = true,
	LeftUpperLegCollision = true,

	RightFootCollision = true,
	RightHandCollision = true,
	RightLowerArmCollision = true,
	RightLowerLegCollision = true,
	RightUpperArmCollision = true,
	RightUpperLegCollision = true,

	Head = true,
	Jaw = true,
}

local LIMB_NAMES = {
	LeftHand = true,
	LeftLowerArm = true,
	LeftUpperArm = true,
	LeftFoot = true,
	LeftLowerLeg = true,
	LeftUpperLeg = true,

	RightHand = true,
	RightLowerArm = true,
	RightUpperArm = true,
	RightFoot = true,
	RightLowerLeg = true,
	RightUpperLeg = true,

	Head = true,
	Jaw = true,
}

local EXTRA_COLLIDER_NAMES = {
	HeadCollision = true,
}

local SENTIENT_ANTI_GRAB_NAMES = {
	Head = true,
	Jaw = true,

	LeftHand = true,
	LeftLowerArm = true,
	LeftUpperArm = true,

	RightHand = true,
	RightLowerArm = true,
	RightUpperArm = true,
}

local function findPartByName(model, partName)
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == partName then
			return obj
		end
	end
	return nil
end

local function findNape(model)
	return findPartByName(model, "Nape")
end

local function isSentientModel(model)
	if not model or not model:IsA("Model") then
		return false
	end

	local hitboxes = model:FindFirstChild("Hitboxes")
	return hitboxes ~= nil and hitboxes:IsA("Folder")
end

local function findFirstBasePart(inst, targetName)
	if not inst then
		return nil
	end

	for _, obj in ipairs(inst:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == targetName then
			return obj
		end
	end

	return nil
end

local function findSentientNape(model)
	local hitboxes = model:FindFirstChild("Hitboxes")
	if not hitboxes then
		return nil
	end

	local nape = hitboxes:FindFirstChild("Nape")
	if nape and nape:IsA("BasePart") then
		return nape
	end

	return findFirstBasePart(hitboxes, "Nape")
end

local function findSentientEyes(model)
	local hitboxes = model:FindFirstChild("Hitboxes")
	if not hitboxes then
		return nil
	end

	local eyes = hitboxes:FindFirstChild("Eyes")
	if eyes and eyes:IsA("BasePart") then
		return eyes
	end

	return findFirstBasePart(hitboxes, "Eyes")
end

local function findSentientHead(model)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end

	return findFirstBasePart(model, "Head")
end

local function findSentientJaw(model)
	local head = findSentientHead(model)
	if not head then
		return nil
	end

	local lowerHinge = head:FindFirstChild("LowerHinge")
	if not lowerHinge then
		return nil
	end

	local jaw = lowerHinge:FindFirstChild("Jaw")
	if jaw and jaw:IsA("BasePart") then
		return jaw
	end

	return findFirstBasePart(lowerHinge, "Jaw")
end

local function findSentientLimbParts(model)
	local parts = {}

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") and SENTIENT_ANTI_GRAB_NAMES[obj.Name] then
			table.insert(parts, obj)
		end
	end

	local jaw = findSentientJaw(model)
	if jaw then
		local exists = false
		for _, p in ipairs(parts) do
			if p == jaw then
				exists = true
				break
			end
		end
		if not exists then
			table.insert(parts, jaw)
		end
	end

	return parts
end

local function storeBasePartState(part)
	if not part or not part:IsA("BasePart") then
		return
	end
	if part:GetAttribute("HB_Stored") then
		return
	end

	part:SetAttribute("HB_Stored", true)
	part:SetAttribute("HB_OrigSizeX", part.Size.X)
	part:SetAttribute("HB_OrigSizeY", part.Size.Y)
	part:SetAttribute("HB_OrigSizeZ", part.Size.Z)

	part:SetAttribute("HB_OrigCanCollide", part.CanCollide and 1 or 0)
	part:SetAttribute("HB_OrigCanTouch", part.CanTouch and 1 or 0)
	part:SetAttribute("HB_OrigCanQuery", part.CanQuery and 1 or 0)
	part:SetAttribute("HB_OrigMassless", part.Massless and 1 or 0)

	local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
	if mesh then
		part:SetAttribute("HB_HasMesh", 1)
		part:SetAttribute("HB_OrigMeshX", mesh.Scale.X)
		part:SetAttribute("HB_OrigMeshY", mesh.Scale.Y)
		part:SetAttribute("HB_OrigMeshZ", mesh.Scale.Z)
	else
		part:SetAttribute("HB_HasMesh", 0)
	end
end

local function restoreBasePartState(part)
	if not part or not part:IsA("BasePart") then
		return
	end
	if not part:GetAttribute("HB_Stored") then
		return
	end

	local sx = part:GetAttribute("HB_OrigSizeX")
	local sy = part:GetAttribute("HB_OrigSizeY")
	local sz = part:GetAttribute("HB_OrigSizeZ")

	if sx and sy and sz then
		part.Size = Vector3.new(sx, sy, sz)
	end

	part.CanCollide = (part:GetAttribute("HB_OrigCanCollide") == 1)
	part.CanTouch = (part:GetAttribute("HB_OrigCanTouch") == 1)
	part.CanQuery = (part:GetAttribute("HB_OrigCanQuery") == 1)
	part.Massless = (part:GetAttribute("HB_OrigMassless") == 1)

	if part:GetAttribute("HB_HasMesh") == 1 then
		local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
		if mesh then
			local mx = part:GetAttribute("HB_OrigMeshX")
			local my = part:GetAttribute("HB_OrigMeshY")
			local mz = part:GetAttribute("HB_OrigMeshZ")
			if mx and my and mz then
				mesh.Scale = Vector3.new(mx, my, mz)
			end
		end
	end
end

local function getOrCreateBox(part, boxName, color)
	local box = part:FindFirstChild(boxName)
	if box and box:IsA("SelectionBox") then
		return box
	end

	box = Instance.new("SelectionBox")
	box.Name = boxName
	box.Adornee = part
	box.LineThickness = 0.05
	box.Color3 = color
	box.SurfaceColor3 = color
	box.Parent = part

	return box
end

local function updatePartBox(part, enabled, transparency, boxName, color)
	local box = part:FindFirstChild(boxName)

	if not enabled then
		if box then
			box:Destroy()
		end
		return
	end

	box = getOrCreateBox(part, boxName, color)
	local t = math.clamp(transparency, 0, 1)
	box.Transparency = t
	box.SurfaceTransparency = t
end

local function applyScaledPart(model, partName, enabled, multiplier, boxEnabled, boxTransparency, boxName, boxColor)
	if not model or not model:IsA("Model") then
		return
	end

	local part = findPartByName(model, partName)
	if not part then
		return
	end

	storeBasePartState(part)

	if enabled then
		part.CanCollide = false
		part.CanTouch = true
		part.CanQuery = true
		part.Massless = true
		part.Anchored = false

		local ox = part:GetAttribute("HB_OrigSizeX")
		local oy = part:GetAttribute("HB_OrigSizeY")
		local oz = part:GetAttribute("HB_OrigSizeZ")

		if ox and oy and oz then
			part.Size = Vector3.new(ox, oy, oz) * multiplier
		end
	else
		restoreBasePartState(part)
	end

	updatePartBox(part, boxEnabled, boxTransparency, boxName, boxColor)
end

local function applyScaledDirectPart(part, enabled, multiplier, boxEnabled, boxTransparency, boxName, boxColor)
	if not part or not part:IsA("BasePart") then
		return
	end

	storeBasePartState(part)

	if enabled then
		part.CanCollide = false
		part.CanTouch = true
		part.CanQuery = true
		part.Massless = true
		part.Anchored = false

		local ox = part:GetAttribute("HB_OrigSizeX")
		local oy = part:GetAttribute("HB_OrigSizeY")
		local oz = part:GetAttribute("HB_OrigSizeZ")

		if ox and oy and oz then
			part.Size = Vector3.new(ox, oy, oz) * multiplier
		end
	else
		restoreBasePartState(part)
	end

	updatePartBox(part, boxEnabled, boxTransparency, boxName, boxColor)
end

local function disableBasePart(part)
	if not part or not part:IsA("BasePart") then
		return
	end
	if part.Name == "Nape" then
		return
	end

	storeBasePartState(part)
	part.CanTouch = false
	part.CanQuery = false
	part.CanCollide = false
	part.Massless = true
end

local function disableAny(inst)
	if inst:IsA("BasePart") then
		disableBasePart(inst)
		return
	end

	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			disableBasePart(d)
		end
	end
end

local function applyDisableGrabHitboxesToRig(rig)
	if not (rig and rig:IsA("Model")) then
		return
	end

	if not State.AntiGrabEnabled then
		for _, d in ipairs(rig:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "Nape" then
				restoreBasePartState(d)
			end
		end
		return
	end

	local collisionsFolder = rig:FindFirstChild("Collisions")
	if collisionsFolder then
		for _, d in ipairs(collisionsFolder:GetDescendants()) do
			if COLLISION_HITBOX_NAMES[d.Name] then
				disableAny(d)
			end
		end
	end

	for _, d in ipairs(rig:GetDescendants()) do
		if LIMB_NAMES[d.Name] then
			disableAny(d)
		end
	end

	local head = rig:FindFirstChild("Head", true)
	if head then
		for _, d in ipairs(head:GetDescendants()) do
			if EXTRA_COLLIDER_NAMES[d.Name] then
				disableAny(d)
			end
		end
	end
end

local function applyDisableGrabHitboxesToSentient(model)
	if not (model and model:IsA("Model")) then
		return
	end

	local protectedParts = {}
	local sentientNape = findSentientNape(model)
	local sentientEyes = findSentientEyes(model)

	if sentientNape then
		protectedParts[sentientNape] = true
	end
	if sentientEyes then
		protectedParts[sentientEyes] = true
	end

	local parts = findSentientLimbParts(model)

	if not State.SentientAntiGrabEnabled then
		for _, part in ipairs(parts) do
			if not protectedParts[part] then
				restoreBasePartState(part)
			end
		end
		return
	end

	for _, part in ipairs(parts) do
		if not protectedParts[part] then
			disableBasePart(part)
		end
	end
end

local function applyToModel(model)
	if isSentientModel(model) then
		return
	end

	applyScaledPart(
		model,
		"Nape",
		State.NapeEnabled,
		State.NapeMultiplier,
		State.NapeBoxEnabled,
		State.NapeBoxTransparency,
		"NapePreviewBox",
		Color3.fromRGB(170, 70, 255)
	)

	applyScaledPart(
		model,
		"Eyes",
		State.EyesEnabled,
		State.EyesMultiplier,
		State.EyesBoxEnabled,
		State.EyesBoxTransparency,
		"EyesPreviewBox",
		Color3.fromRGB(120, 40, 255)
	)

	applyDisableGrabHitboxesToRig(model)
end

local function applyToSentient(model)
	if not isSentientModel(model) then
		return
	end

	local nape = findSentientNape(model)
	local eyes = findSentientEyes(model)

	applyScaledDirectPart(
		nape,
		State.SentientNapeEnabled,
		State.SentientNapeMultiplier,
		State.SentientNapeBoxEnabled,
		State.SentientNapeBoxTransparency,
		"SentientNapePreviewBox",
		Color3.fromRGB(255, 120, 70)
	)

	applyScaledDirectPart(
		eyes,
		State.SentientEyesEnabled,
		State.SentientEyesMultiplier,
		State.SentientEyesBoxEnabled,
		State.SentientEyesBoxTransparency,
		"SentientEyesPreviewBox",
		Color3.fromRGB(255, 80, 120)
	)

	applyDisableGrabHitboxesToSentient(model)
end

local function applyToAllTitans()
	for _, titan in ipairs(TitansFolder:GetChildren()) do
		if isSentientModel(titan) then
			applyToSentient(titan)
		else
			applyToModel(titan)
		end
	end
end

track(TitansFolder.ChildAdded:Connect(function(model)
	task.wait(0.15)

	if isSentientModel(model) then
		applyToSentient(model)
	else
		applyToModel(model)
	end

	task.delay(0.75, function()
		if model and model.Parent then
			if isSentientModel(model) then
				applyToSentient(model)
			else
				applyToModel(model)
			end
		end
	end)
end))

local titanEspByNape = {}
local playerEspByModel = {}
local refillEspByObj = {}

local function getModelPrimaryDisplayPart(model)
	if not model or not model:IsA("Model") then
		return nil
	end

	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end

	if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
		return model.PrimaryPart
	end

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			return d
		end
	end

	return nil
end

local function makeBillboard(adornee, name, color, sizeX, sizeY, studsOffset)
	local bb = Instance.new("BillboardGui")
	bb.Name = name
	bb.Adornee = adornee
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(sizeX or 240, sizeY or 34)
	bb.StudsOffset = studsOffset or Vector3.new(0, 3, 0)

	local label = Instance.new("TextLabel")
	label.Name = "Info"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.35
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Text = ""
	label.Parent = bb

	bb.Parent = adornee
	return bb, label
end

local function makeSelectionBox(part, name, color, transparency)
	local box = Instance.new("SelectionBox")
	box.Name = name
	box.Adornee = part
	box.LineThickness = 0.05
	box.Color3 = color
	box.SurfaceColor3 = color
	box.Transparency = transparency
	box.SurfaceTransparency = transparency
	box.Parent = part
	return box
end

local function attachTitanESP(model)
	if not State.TitanESP then
		return
	end
	if not model or not model:IsA("Model") then
		return
	end

	local nape = isSentientModel(model) and findSentientNape(model) or findNape(model)
	if not nape then
		return
	end
	if titanEspByNape[nape] then
		return
	end

	local t = math.clamp(State.TitanESPBoxTransparency, 0, 1)
	local box = makeSelectionBox(nape, "TitanESP_Box", Color3.fromRGB(170, 70, 255), t)
	local bb, label = makeBillboard(nape, "TitanESP_Info", Color3.fromRGB(255, 255, 255), 250, 36, Vector3.new(0, 3.1, 0))

	titanEspByNape[nape] = {
		box = box,
		bb = bb,
		label = label,
		model = model,
	}

	track(nape.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			local info = titanEspByNape[nape]
			if info then
				if info.box then info.box:Destroy() end
				if info.bb then info.bb:Destroy() end
			end
			titanEspByNape[nape] = nil
		end
	end))
end

local function detachAllTitanESP()
	for nape, info in pairs(titanEspByNape) do
		if info.box then info.box:Destroy() end
		if info.bb then info.bb:Destroy() end
		titanEspByNape[nape] = nil
	end
end

local function refreshTitanESPTransparency()
	local t = math.clamp(State.TitanESPBoxTransparency, 0, 1)
	for _, info in pairs(titanEspByNape) do
		if info.box then
			info.box.Transparency = t
			info.box.SurfaceTransparency = t
		end
	end
end

local function attachPlayerESP(model)
	if not State.PlayerESP then
		return
	end
	if not model or not model:IsA("Model") then
		return
	end
	if model.Name == player.Name then
		return
	end
	if playerEspByModel[model] then
		return
	end

	local part = getModelPrimaryDisplayPart(model)
	if not part then
		return
	end

	local bb, label = makeBillboard(part, "PlayerESP_Info", Color3.fromRGB(210, 170, 255), 300, 38, Vector3.new(0, 3.2, 0))
	playerEspByModel[model] = {
		bb = bb,
		label = label,
		part = part,
		model = model,
	}

	track(model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			local info = playerEspByModel[model]
			if info and info.bb then
				info.bb:Destroy()
			end
			playerEspByModel[model] = nil
		end
	end))
end

local function detachAllPlayerESP()
	for model, info in pairs(playerEspByModel) do
		if info.bb then
			info.bb:Destroy()
		end
		playerEspByModel[model] = nil
	end
end

local function getInteractablePart(obj)
	if obj:IsA("BasePart") then
		return obj
	end
	if obj:IsA("Model") then
		return getModelPrimaryDisplayPart(obj)
	end
	return nil
end

local function attachRefillESP(obj)
	if not State.RefillESP then
		return
	end
	if not obj then
		return
	end
	if refillEspByObj[obj] then
		return
	end

	local part = getInteractablePart(obj)
	if not part then
		return
	end

	local bb, label = makeBillboard(part, "RefillESP_Info", Color3.fromRGB(145, 82, 255), 260, 34, Vector3.new(0, 2.8, 0))
	refillEspByObj[obj] = {
		bb = bb,
		label = label,
		part = part,
		obj = obj,
	}

	track(obj.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			local info = refillEspByObj[obj]
			if info and info.bb then
				info.bb:Destroy()
			end
			refillEspByObj[obj] = nil
		end
	end))
end

local function detachAllRefillESP()
	for obj, info in pairs(refillEspByObj) do
		if info.bb then
			info.bb:Destroy()
		end
		refillEspByObj[obj] = nil
	end
end

local function refreshAllVisualESP()
	detachAllTitanESP()
	detachAllPlayerESP()
	detachAllRefillESP()

	if State.TitanESP then
		for _, titan in ipairs(TitansFolder:GetChildren()) do
			attachTitanESP(titan)
		end
	end

	if State.PlayerESP then
		for _, model in ipairs(CharactersFolder:GetChildren()) do
			attachPlayerESP(model)
		end
	end

	if State.RefillESP then
		for _, obj in ipairs(InteractablesFolder:GetChildren()) do
			attachRefillESP(obj)
		end
	end
end

track(TitansFolder.ChildAdded:Connect(function(model)
	task.wait(0.1)
	if State.TitanESP then
		attachTitanESP(model)
	end
end))

track(CharactersFolder.ChildAdded:Connect(function(model)
	task.wait(0.1)
	if State.PlayerESP then
		attachPlayerESP(model)
	end
end))

track(InteractablesFolder.ChildAdded:Connect(function(obj)
	task.wait(0.05)
	if State.RefillESP then
		attachRefillESP(obj)
	end
end))

track(TitansFolder.ChildRemoved:Connect(function()
	task.defer(refreshAllVisualESP)
end))

track(CharactersFolder.ChildRemoved:Connect(function()
	task.defer(refreshAllVisualESP)
end))

track(InteractablesFolder.ChildRemoved:Connect(function()
	task.defer(refreshAllVisualESP)
end))

track(RunService.RenderStepped:Connect(function()
	local localRoot = getLocalRoot()
	if not localRoot then
		return
	end

	if State.TitanESP then
		for nape, info in pairs(titanEspByNape) do
			if not (nape and nape.Parent and info and info.label and info.model) then
				titanEspByNape[nape] = nil
			else
				local dist = (localRoot.Position - nape.Position).Magnitude
