local function switchPage(name)
	for pageName, page in pairs(pages) do
		page.Visible = (pageName == name)
	end

	for tabName, tab in pairs(tabButtons) do
		local active = (tabName == name)
		tab.BackgroundColor3 = active and COL_TAB_ACTIVE or COL_TAB
		tab.TextColor3 = active and COL_TEXT or COL_SUB
	end
end

local function createTab(y, text, pageName)
	local btn = mk("TextButton", {
		Parent = sideBar,
		Position = UDim2.new(0, 12, 0, y),
		Size = UDim2.new(1, -24, 0, 38),
		BackgroundColor3 = COL_TAB,
		BorderSizePixel = 0,
		Text = "   " .. text,
		TextColor3 = COL_SUB,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamSemibold,
		TextSize = 13,
		AutoButtonColor = false,
	})
	mk("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 10)})
	mk("UIStroke", {Parent = btn, Color = COL_STROKE_SOFT, Thickness = 1, Transparency = 0.2})

	tabButtons[pageName] = btn
	track(btn.MouseButton1Click:Connect(function()
		switchPage(pageName)
	end))
end

