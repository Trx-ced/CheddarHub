local minimized = false
local fullSize = main.Size

track(hideBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	sideBar.Visible = not minimized
	contentHolder.Visible = not minimized
	main.Size = minimized and UDim2.new(fullSize.X.Scale, fullSize.X.Offset, 0, 50) or fullSize
	hideBtn.Text = minimized and "+" or "—"
end))

do
	local dragging = false
	local dragStart
	local startPos

	track(topBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end))
end

track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if bindingVelocityKey then
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			State.VelocityKeybind = input.KeyCode
			bindingVelocityKey = false
			refreshUI()
		end
		return
	end

	if bindingSafeFallKey then
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			State.SafeFallKey = input.KeyCode
			bindingSafeFallKey = false
			refreshUI()
		end
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		gui.Enabled = not gui.Enabled
		return
	end

	if input.KeyCode == State.VelocityKeybind then
		velocityKeyHeld = true
	end

	if input.KeyCode == State.SafeFallKey then
		State.SafeFallEnabled = not State.SafeFallEnabled
		refreshUI()
	end
end))

track(UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == State.VelocityKeybind then
		velocityKeyHeld = false
	end
end))

