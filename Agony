local VelocityMod = {
	Enabled = false,

	Multiplier = 2.5,
	AddSpeed = 300,
	MaxSpeed = 300,

	BoostRampPerStep = 12,
	BoostDecayPerStep = 8,

	BaseTurnBlend = 0.05,
	ExtraTurnBlend = 0.08,
	GyroTurnBias = 0.05,
	MinPlanarSpeed = 2,

	Force = Vector3.new(1e9, 1e9, 1e9),
	P = 50000,
}

local lastBV = nil
local lastDebugId = nil
local originalMaxForce = nil
local originalP = nil
local touchedBV = false
local heldBoostSpeed = 0
local boosting = false
local velocityKeyHeld = false

local function resolveVelocityTarget()
	local direct = CharactersFolder:FindFirstChild(player.Name)
	if direct and direct:IsA("Model") then
		local hrp = direct:FindFirstChild("HumanoidRootPart")
		local hum = direct:FindFirstChildOfClass("Humanoid")
		if hrp and hum then
			return direct, hum, hrp
		end
	end

	local lowerName = string.lower(player.Name)
	local lowerDisplay = string.lower(player.DisplayName)

	for _, model in ipairs(CharactersFolder:GetChildren()) do
		if model:IsA("Model") then
			local hrp = model:FindFirstChild("HumanoidRootPart")
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hrp and hum then
				local n = string.lower(model.Name)
				if n == lowerName or n == lowerDisplay or string.find(n, lowerName, 1, true) or string.find(n, lowerDisplay, 1, true) then
					return model, hum, hrp
				end
			end
		end
	end

	return nil
end

local function findMainBodyVelocity(root)
	if not root then
		return nil
	end

	local bv = root:FindFirstChild("MainBodyVelocity")
	if bv and bv:IsA("BodyVelocity") then
		return bv
	end

	for _, child in ipairs(root:GetChildren()) do
		if child:IsA("BodyVelocity") then
			return child
		end
	end

	return nil
end

local function findMainBodyGyro(root)
	if not root then
		return nil
	end

	local bg = root:FindFirstChild("MainBodyGyro")
	if bg and bg:IsA("BodyGyro") then
		return bg
	end

	for _, child in ipairs(root:GetChildren()) do
		if child:IsA("BodyGyro") then
			return child
		end
	end

	return nil
end

local function restoreBodyVelocity()
	if lastBV and lastBV.Parent and touchedBV then
		if originalMaxForce then
			pcall(function()
				lastBV.MaxForce = originalMaxForce
			end)
		end
		if originalP ~= nil then
			pcall(function()
				lastBV.P = originalP
			end)
		end
	end

	lastBV = nil
	lastDebugId = nil
	originalMaxForce = nil
	originalP = nil
	touchedBV = false
	heldBoostSpeed = 0
	boosting = false
end

local function canVelocityRun()
	if not VelocityMod.Enabled then
		return false
	end

	if UserInputService:GetFocusedTextBox() then
		return false
	end

	local hookHeld = UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.E)
	if not hookHeld then
		return false
	end

	if State.VelocityUseKeybind and not velocityKeyHeld then
		return false
	end

	return true
end

local function applyVelocityOnce()
	VelocityMod.Multiplier = clamp(VelocityMod.Multiplier, 1, 5)
	VelocityMod.AddSpeed = clamp(VelocityMod.AddSpeed, 0, 1000)
	VelocityMod.MaxSpeed = clamp(VelocityMod.MaxSpeed, 1, 4000)

	if not canVelocityRun() then
		restoreBodyVelocity()
		return
	end

	local model, humanoid, root = resolveVelocityTarget()
	if not model or not root then
		restoreBodyVelocity()
		return
	end

	local bv = findMainBodyVelocity(root)
	if not bv then
		restoreBodyVelocity()
		return
	end

	local bg = findMainBodyGyro(root)

	local debugId = bv:GetDebugId()
	if bv ~= lastBV or debugId ~= lastDebugId then
		restoreBodyVelocity()
		lastBV = bv
		lastDebugId = debugId
		originalMaxForce = bv.MaxForce
		originalP = bv.P
		touchedBV = false
	end

	if bv.MaxForce ~= VelocityMod.Force then
		bv.MaxForce = VelocityMod.Force
		touchedBV = true
	end

	if bv.P ~= VelocityMod.P then
		bv.P = VelocityMod.P
		touchedBV = true
	end

	local currentVelocity = bv.Velocity
	local currentPlanar = planar(currentVelocity)
	local currentSpeed = currentPlanar.Magnitude

	local velDir = safeUnit(currentPlanar)
	local gyroDir = Vector3.zero

	if bg then
		gyroDir = safeUnit(planar(bg.CFrame.LookVector))
	end
	if gyroDir.Magnitude <= 1e-6 then
		gyroDir = safeUnit(planar(root.CFrame.LookVector))
	end
	if velDir.Magnitude <= 1e-6 then
		velDir = gyroDir
	end
	if gyroDir.Magnitude <= 1e-6 then
		gyroDir = velDir
	end

	local desiredDir = safeUnit(lerpVec(velDir, gyroDir, VelocityMod.GyroTurnBias))
	if desiredDir.Magnitude <= 1e-6 then
		desiredDir = velDir.Magnitude > 1e-6 and velDir or gyroDir
	end
	if desiredDir.Magnitude <= 1e-6 then
		return
	end

	if not boosting then
		local startSpeed = currentSpeed
		if startSpeed < VelocityMod.MinPlanarSpeed then
			startSpeed = VelocityMod.MinPlanarSpeed
		end

		heldBoostSpeed = clamp(
			(startSpeed * VelocityMod.Multiplier) + VelocityMod.AddSpeed,
			0,
			VelocityMod.MaxSpeed
		)
		boosting = true
	else
		local desiredHeld = clamp(
			(math.max(currentSpeed, VelocityMod.MinPlanarSpeed) * VelocityMod.Multiplier) + VelocityMod.AddSpeed,
			0,
			VelocityMod.MaxSpeed
		)

		if desiredHeld > heldBoostSpeed then
			heldBoostSpeed = math.min(heldBoostSpeed + VelocityMod.BoostRampPerStep, desiredHeld)
		else
			heldBoostSpeed = math.max(heldBoostSpeed - VelocityMod.BoostDecayPerStep, desiredHeld)
		end
	end

	local targetPlanar = desiredDir * heldBoostSpeed

	local dot = clamp(velDir:Dot(desiredDir), -1, 1)
	local turnAmount = 1 - math.max(dot, 0)
	local turnBlend = clamp(
		VelocityMod.BaseTurnBlend + (turnAmount * VelocityMod.ExtraTurnBlend),
		0,
		1
	)

	local blendedPlanar
	if currentPlanar.Magnitude > 0.01 then
		blendedPlanar = lerpVec(currentPlanar, targetPlanar, turnBlend)
	else
		blendedPlanar = targetPlanar
	end

	if blendedPlanar.Magnitude > VelocityMod.MaxSpeed then
		blendedPlanar = safeUnit(blendedPlanar) * VelocityMod.MaxSpeed
	end

	bv.Velocity = Vector3.new(blendedPlanar.X, currentVelocity.Y, blendedPlanar.Z)
end

local velocityStepEvent = RunService.PreSimulation or RunService.Heartbeat
track(velocityStepEvent:Connect(applyVelocityOnce))
track(RunService.Heartbeat:Connect(applyVelocityOnce))

