	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		gui.Enabled = not gui.Enabled
	elseif input.KeyCode == Enum.KeyCode.L then
		State.PlayerESPEnabled = not State.PlayerESPEnabled
		if not State.PlayerESPEnabled then
			clearESPType("Player")
			notify("Player ESP disabled")
		else
			scanESPFolder(PlayerCharactersFolder, "Player")
			notify("Player ESP enabled")
		end
		refreshUI()
	elseif input.KeyCode == Enum.KeyCode.K then
		State.TitanESPEnabled = not State.TitanESPEnabled
		if not State.TitanESPEnabled then
			clearESPType("Titan")
			notify("Titan ESP disabled")
		else
			scanESPFolder(TitansFolder, "Titan")
			notify("Titan ESP enabled")
		end
		refreshUI()
	end
end)

