local function saveConfig(slotName)
	SavedConfigs[slotName] = cloneTable(State)
	notify(slotName .. " saved")
end

local function loadConfig(slotName)
	if not SavedConfigs[slotName] then
		notify(slotName .. " is empty")
		return
	end

	copyState(SavedConfigs[slotName])
	applyAllSystems()

	if State.PlayerESPEnabled then
		scanESPFolder(PlayerCharactersFolder, "Player")
	else
		clearESPType("Player")
	end

	if State.TitanESPEnabled then
		scanESPFolder(TitansFolder, "Titan")
	else
		clearESPType("Titan")
	end

	notify(slotName .. " loaded")
end

local function resetConfig()
	copyState(DefaultState)
	applyAllSystems()
	clearESPType("Player")
	clearESPType("Titan")
	notify("Config reset")
end

