local notifyTween = nil
local function notify(text)
	if notifyTween then
		notifyTween:Cancel()
	end

	notificationLabel.Text = text
	notificationLabel.Visible = true
	notificationLabel.BackgroundTransparency = 1
	notificationLabel.TextTransparency = 1

	local fadeIn1 = TweenService:Create(notificationLabel, TweenInfo.new(0.18), {
		BackgroundTransparency = 0,
		TextTransparency = 0,
	})
	fadeIn1:Play()

	task.delay(1.8, function()
		if notificationLabel.Text ~= text then
			return
		end
		notifyTween = TweenService:Create(notificationLabel, TweenInfo.new(0.2), {
			BackgroundTransparency = 1,
			TextTransparency = 1,
		})
		notifyTween:Play()
		notifyTween.Completed:Wait()
		if notificationLabel.Text == text then
			notificationLabel.Visible = false
		end
	end)
end

