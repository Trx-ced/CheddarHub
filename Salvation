RunService.RenderStepped:Connect(function()
	for _, titan in ipairs(workspace:GetChildren()) do
		local napeHB = titan:FindFirstChild("NapeHB", true)

		if napeHB and napeHB:IsA("BasePart") then
			rememberPart(napeHB)

			if State.NapeEnabled then
				napeHB.Size = Vector3.new(State.NapeSize, State.NapeSize, State.NapeSize)
				napeHB.Transparency = State.NapeTransparency
				napeHB.Color = Color3.fromRGB(255, 0, 0)
				napeHB.CanCollide = false
			else
				restorePart(napeHB)
			end
		end

		local hitboxes = titan:FindFirstChild("Hitboxes")
		if hitboxes then
			local grabBox = hitboxes:FindFirstChild("NapeSwingBox")

			if grabBox and grabBox:IsA("BasePart") then
				rememberPart(grabBox)

				if State.AntiGrabEnabled then
					grabBox.CanTouch = false
					grabBox.CanQuery = false
					grabBox.CanCollide = false
					grabBox.Size = Vector3.new(0.05, 0.05, 0.05)
					grabBox.Transparency = 1
				else
					restorePart(grabBox)
				end
			end
		end
	end

	if State.GearEnabled or State.GasEnabled then
		applyGearMods()
	end

	if State.FistsEnabled or State.BladesEnabled or State.SabreEnabled then
		applyCombatMods()
	end

	if State.StatModifierEnabled and player.Character then
		applyStatBuffsToCharacter(player.Character)
	end

	if State.TPMultiplierEnabled then
		applyTPMultiplier()
	end

	if State.InjuryNullEnabled then
		applyInjuryNull()
	end

	updateESP()
end)

