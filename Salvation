local function makePage(name, scrolling, canvasHeight)
	local page
	if scrolling then
		page = Instance.new("ScrollingFrame")
		page.CanvasSize = UDim2.new(0, 0, 0, canvasHeight or 1000)
		page.ScrollBarThickness = 6
		page.ScrollBarImageColor3 = Color3.fromRGB(70, 120, 255)
		page.AutomaticCanvasSize = Enum.AutomaticSize.None
	else
		page = Instance.new("Frame")
	end

	page.Name = name
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.Visible = false
	page.Parent = contentHolder

	Pages[name] = page
	return page
end

