local function applyBuffFolder(dataFolder, folderName, statValues)
	local buffFolder = dataFolder:FindFirstChild(folderName)
	if not buffFolder then
		buffFolder = Instance.new("Folder")
		buffFolder.Name = folderName
		buffFolder.Parent = dataFolder
	end

	for statName, amount in pairs(statValues) do
		local valueObj = buffFolder:FindFirstChild(statName)
		if not valueObj then
			valueObj = Instance.new("NumberValue")
			valueObj.Name = statName
			valueObj.Parent = buffFolder
		end
		valueObj.Value = amount
	end
end

local function removeBuffFolder(dataFolder, folderName)
	local buffFolder = dataFolder:FindFirstChild(folderName)
	if buffFolder then
		buffFolder:Destroy()
	end
end

local function applyStatBuffsToCharacter(character)
	local dataFolder = character and character:FindFirstChild("Data")
	if not dataFolder then
		return
	end

	local buffs = getBuffTemplate()

	if State.StatModifierEnabled then
		for folderName, statValues in pairs(buffs) do
			applyBuffFolder(dataFolder, folderName, statValues)
		end
	else
		for folderName in pairs(buffs) do
			removeBuffFolder(dataFolder, folderName)
		end
	end
end

local function applyTPMultiplier()
	if not TPModule or type(TPModule) ~= "table" then
		return
	end

	if type(TPAwardOriginal) ~= "function" then
		TPAwardOriginal = TPModule.AwardTP
	end

	if State.TPMultiplierEnabled then
		TPModule.AwardTP = function(playerObj, baseAmount)
			if type(baseAmount) ~= "number" then
				baseAmount = tonumber(baseAmount) or 0
			end

			local day = os.date("%A")

			if day == "Tuesday" or day == "Wednesday" or day == "Saturday" or day == "Sunday" then
				baseAmount = baseAmount * 10000000000000
			else
				baseAmount = baseAmount * 1000000000000000
			end

			local data = playerObj and playerObj:FindFirstChild("Data")
			local talents = data and data:FindFirstChild("Talents")
			local tp = talents and talents:FindFirstChild("TalentPoints")

			if tp and tp:IsA("NumberValue") then
				tp.Value = tp.Value + baseAmount
			elseif tp and tp:IsA("IntValue") then
				tp.Value = tp.Value + math.floor(baseAmount)
			end
		end
	else
		if type(TPAwardOriginal) == "function" then
			TPModule.AwardTP = TPAwardOriginal
		end
	end
end

local function applyInjuryNull()
	if not State.InjuryNullEnabled then
		return
	end

	local character = player.Character
	local data = character and character:FindFirstChild("Data")
	local injuries = data and data:FindFirstChild("InjuryTags")

	if injuries then
		for attrName, _ in pairs(injuries:GetAttributes()) do
			injuries:SetAttribute(attrName, nil)
		end
		injuries:ClearAllChildren()
	end
end

local ESPObjects = {}
local ESP_UPDATE_INTERVAL = 0.25
local ESP_LAST_UPDATE = 0
local PLAYER_ESP_MAX_DISTANCE = 2000
local TITAN_ESP_MAX_DISTANCE = 1500
local PlayerCharactersFolder = workspace:WaitForChild("World"):WaitForChild("Entities"):WaitForChild("PlayerCharacters")
local TitansFolder = workspace:WaitForChild("World"):WaitForChild("Entities"):WaitForChild("Titans")

local function getRootPart(char)
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
end

local function getESPPart(model, espType)
	if not model then
		return nil
	end

	if espType == "Player" then
		local head = model:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			return head
		end
	end

	local primary = model.PrimaryPart
	if primary and primary:IsA("BasePart") then
		return primary
	end

	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end

	local torso = model:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end

	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end

	return model:FindFirstChildWhichIsA("BasePart")
end

local function removeESP(model)
	local data = ESPObjects[model]
	if not data then
		return
	end

	if data.Gui then
		data.Gui:Destroy()
	end

	if data.Connection then
		data.Connection:Disconnect()
	end

	ESPObjects[model] = nil
end

local function clearESPType(espType)
	local toRemove = {}
	for model, data in pairs(ESPObjects) do
		if data.Type == espType then
			toRemove[#toRemove + 1] = model
		end
	end

	for _, model in ipairs(toRemove) do
		removeESP(model)
	end
end

local function createESP(model, espType)
	if not model or not model:IsA("Model") then
		return
	end

	if espType == "Player" and not State.PlayerESPEnabled then
		return
	end

	if espType == "Titan" and not State.TitanESPEnabled then
		return
	end

	if ESPObjects[model] then
		return
	end

	local adornee = getESPPart(model, espType)
	if not adornee then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = espType == "Player" and "PlayerESP" or "TitanESP"
	billboard.Adornee = adornee
	billboard.Size = UDim2.new(0, 220, 0, 40)
	billboard.StudsOffset = espType == "Player" and Vector3.new(0, 3, 0) or Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.ResetOnSpawn = false
	billboard.Enabled = true
	billboard.Parent = adornee

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Font = Enum.Font.RobotoMono
	label.TextSize = 14
	label.TextStrokeTransparency = 0
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = model.Name
	label.Parent = billboard

	local ancestryConnection = model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			removeESP(model)
		end
	end)

	ESPObjects[model] = {
		Gui = billboard,
		Label = label,
		Connection = ancestryConnection,
		Type = espType,
		Part = adornee,
		LastText = nil,
		LastColor = nil,
	}
end

local function scanESPFolder(folder, espType)
	for _, obj in ipairs(folder:GetChildren()) do
		createESP(obj, espType)
	end
end

local function updateESP(force)
	local now = os.clock()
	if not force and now - ESP_LAST_UPDATE < ESP_UPDATE_INTERVAL then
		return
	end
	ESP_LAST_UPDATE = now

	local character = player.Character
	local myRoot = getRootPart(character)

	if not myRoot then
		return
	end

	local myPos = myRoot.Position

	for model, data in pairs(ESPObjects) do
		if not model or not model.Parent then
			removeESP(model)
			continue
		end

		if data.Type == "Player" and not State.PlayerESPEnabled then
			removeESP(model)
			continue
		end

		if data.Type == "Titan" and not State.TitanESPEnabled then
			removeESP(model)
			continue
		end

		local part = data.Part
		if not part or not part.Parent then
			part = getESPPart(model, data.Type)
			if not part then
				removeESP(model)
				continue
			end
			data.Part = part
			data.Gui.Adornee = part
			data.Gui.Parent = part
		end

		local dist = math.floor((myPos - part.Position).Magnitude)
		local maxDistance = data.Type == "Titan" and TITAN_ESP_MAX_DISTANCE or PLAYER_ESP_MAX_DISTANCE
		local visible = dist <= maxDistance

		if data.Gui.Enabled ~= visible then
			data.Gui.Enabled = visible
		end

		if not visible then
			continue
		end

		local newText
		local newColor

		if data.Type == "Player" then
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hum then
				local hp = math.floor(hum.Health)
				local maxHp = math.floor(hum.MaxHealth)
				local healthPercent = hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth) or 0
				newColor = Color3.fromHSV(healthPercent * 0.3, 1, 1)
				newText = model.Name .. " | HP: " .. hp .. "/" .. maxHp .. " | " .. dist
			else
				newColor = Color3.fromRGB(255, 255, 255)
				newText = model.Name .. " | " .. dist
			end
		else
			newColor = Color3.fromRGB(255, 255, 255)
			newText = model.Name .. " | " .. dist
		end

		if data.LastColor ~= newColor then
			data.Label.TextColor3 = newColor
			data.LastColor = newColor
		end

		if data.LastText ~= newText then
			data.Label.Text = newText
			data.LastText = newText
		end
	end

	if State.PlayerESPEnabled then
		for _, model in ipairs(PlayerCharactersFolder:GetChildren()) do
			if not ESPObjects[model] then
				createESP(model, "Player")
			end
		end
	end

	if State.TitanESPEnabled then
		for _, model in ipairs(TitansFolder:GetChildren()) do
			if not ESPObjects[model] then
				createESP(model, "Titan")
			end
		end
	end
end

