local function ensureGearOriginals()
	if not ODMG or GearOriginals.Stored then
		return
	end

	GearOriginals.Stored = true

	local g1 = ODMG["Generation 1"]
	local g2 = ODMG["Generation 2"]

	if g1 then
		for _, key in ipairs(GearKeysToStore) do
			GearOriginals.Generation1[key] = g1[key]
		end
	end

	if g2 then
		for _, key in ipairs(GearKeysToStore) do
			GearOriginals.Generation2[key] = g2[key]
		end
	end
end

local function ensureCombatOriginals()
