local function applyNapeValues()
	local size = tonumber(napeSizeBox.Text)
	local transparency = tonumber(napeTransparencyBox.Text)

	if size then
		State.NapeSize = clamp(size, 1, 200)
	end

	if transparency then
		State.NapeTransparency = clamp(transparency, 0, 1)
	end

	refreshUI()
end

local function readNumber(box, key, minValue, maxValue)
	local n = tonumber(box.Text)
	if not n then
		box.Text = tostring(State[key])
		return
	end

	State[key] = clamp(n, minValue, maxValue)
	box.Text = tostring(State[key])
end

