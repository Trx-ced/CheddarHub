--// Shifter handling
local shifterOriginals = setmetatable({}, { __mode = "k" })
local shifterEspByModel = {}

local function rememberShifterOriginal(part)
	if not part then
		return
	end

	if not shifterOriginals[part] then
		shifterOriginals[part] = {
			Size = part.Size,
			CanCollide = part.CanCollide,
		}
	end
end

local function restoreShifterPart(part)
	local original = shifterOriginals[part]
	if not part or not part.Parent or not original then
		return
	end

	part.Size = original.Size
	part.CanCollide = original.CanCollide
end

local function applyShifterExpansionToModel(model)
	if not isShifterModel(model) then
		return
	end

	local nape = findNape(model)
	local eyes = findEyes(model)

	if nape then
		rememberShifterOriginal(nape)

		if SETTINGS.ShifterNapeEnabled then
			local original = shifterOriginals[nape]
			if original then
				nape.Size = original.Size * SETTINGS.ShifterNapeMultiplier
				nape.CanCollide = false
			end
		else
			restoreShifterPart(nape)
		end
	end

	for _, eye in ipairs(eyes) do
		rememberShifterOriginal(eye)

		if SETTINGS.ShifterEyesEnabled then
			local original = shifterOriginals[eye]
			if original then
				eye.Size = original.Size * SETTINGS.ShifterEyesMultiplier
				eye.CanCollide = false
			end
		else
			restoreShifterPart(eye)
		end
	end
end

local function refreshShifterExpansion()
	if not charactersFolder then
		return
	end

	for _, model in ipairs(charactersFolder:GetChildren()) do
		if model:IsA("Model") then
			applyShifterExpansionToModel(model)
		end
	end
end

local function removeShifterESP(model)
	local info = shifterEspByModel[model]
	if not info then
		return
	end
	if info.billboard then
		info.billboard:Destroy()
	end
	shifterEspByModel[model] = nil
end

local function attachShifterESP(model)
	if not SETTINGS.ShifterESPEnabled then
		return
	end
	if not isShifterModel(model) then
		return
	end
	if shifterEspByModel[model] then
		return
	end

	local adornee = getShifterAdornee(model)
	if not adornee then
		return
	end

	local bb = Instance.new("BillboardGui")
	bb.Name = "_ShifterESP"
	bb.Adornee = adornee
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(210, 50)
	bb.StudsOffset = Vector3.new(0, 4.4, 0)
	bb.Parent = adornee

	local glowBack = Instance.new("Frame")
	glowBack.BackgroundColor3 = COLORS.SHIFTER_RED
	glowBack.BackgroundTransparency = 0.25
	glowBack.Size = UDim2.new(1, 0, 1, 0)
	glowBack.BorderSizePixel = 0
	glowBack.Parent = bb
	addCorner(glowBack, 10)

	local glowStroke = Instance.new("UIStroke")
	glowStroke.Color = COLORS.SHIFTER_RED
	glowStroke.Thickness = 2
	glowStroke.Transparency = 0
	glowStroke.Parent = glowBack

	local glow = Instance.new("UIGradient")
	glow.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, COLORS.SHIFTER_RED_SOFT),
		ColorSequenceKeypoint.new(1, COLORS.SHIFTER_RED),
	})
	glow.Rotation = 90
	glow.Parent = glowBack

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "SHIFTER"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = COLORS.SHIFTER_RED
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 22
	label.Parent = bb

	local labelStroke = Instance.new("UIStroke")
	labelStroke.Color = COLORS.SHIFTER_RED
	labelStroke.Thickness = 1.75
	labelStroke.Transparency = 0
	labelStroke.Parent = label

	shifterEspByModel[model] = {
		billboard = bb,
		adornee = adornee,
	}

	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeShifterESP(model)
		end
	end)
end

local function refreshShifterESP()
	for model in pairs(shifterEspByModel) do
		removeShifterESP(model)
	end

	if not SETTINGS.ShifterESPEnabled or not charactersFolder then
		return
	end

	for _, model in ipairs(charactersFolder:GetChildren()) do
		attachShifterESP(model)
	end
end

if charactersFolder then
	charactersFolder.ChildAdded:Connect(function(model)
		task.wait(0.15)
		if model:IsA("Model") then
			applyShifterExpansionToModel(model)
			attachShifterESP(model)
		end
	end)

	charactersFolder.ChildRemoved:Connect(function(model)
		removeShifterESP(model)
	end)
end

RunService.RenderStepped:Connect(function()
	local localRoot = getLocalRoot()
	if localRoot then
		for nape, info in pairs(titanEspByNape) do
			if not nape or not nape.Parent or not info.label then
				removeTitanESPByNape(nape)
			else
				if info.box then
					info.box.Transparency = SETTINGS.TitanESPTransparency
					info.box.SurfaceTransparency = SETTINGS.TitanESPTransparency
				end
				local dist = (localRoot.Position - nape.Position).Magnitude
				info.label.Text = string.format("%s | %.1f studs", info.model.Name, dist)
			end
		end

		for model, info in pairs(characterEspByModel) do
			local humanoid = info.humanoid
			local root = info.root

			if not model or not model.Parent or not root or not root.Parent or not humanoid or not humanoid.Parent or not info.label then
				removeCharacterESP(model)
			else
				if info.box then
					info.box.Transparency = SETTINGS.CharacterESPTransparency
					info.box.SurfaceTransparency = SETTINGS.CharacterESPTransparency
				end

				local dist = (localRoot.Position - root.Position).Magnitude
				info.label.Text = string.format(
					"%s\nDistance: %.1f\nHealth: %d/%d",
					model.Name,
					dist,
					math.floor(humanoid.Health),
					math.floor(humanoid.MaxHealth)
				)
			end
		end

		for model, info in pairs(refillEspByModel) do
			local root = getPlacementRoot(model)

			if not model or not model.Parent or not root or not root.Parent or not info.label then
				removeRefillESP(model)
			else
				info.root = root
				if info.bb then
					info.bb.Adornee = root
				end
				if info.box then
					info.box.Adornee = root
					info.box.Transparency = SETTINGS.RefillESPTransparency
					info.box.SurfaceTransparency = SETTINGS.RefillESPTransparency
				end

				local dist = (localRoot.Position - root.Position).Magnitude
				info.label.Text = string.format("%s | %.1f studs", model.Name, dist)
			end
		end
	end
end)

