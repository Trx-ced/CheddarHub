end

local function findNape(model)
	if not model then
		return nil
	end
	local nape = model:FindFirstChild("Nape", true)
	if nape and nape:IsA("BasePart") then
		return nape
	end
	return nil
end

local function findEyes(model)
	if not model then
		return {}
	end

	local eyes = {}
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Eyes" then
			table.insert(eyes, obj)
		end
	end
	return eyes
end

local function isShifterModel(model)
	return model and model:IsA("Model") and findNape(model) ~= nil
end

local function getShifterAdornee(model)
	if not model then
		return nil
	end

	return model:FindFirstChild("Head", true)
		or model:FindFirstChild("HumanoidRootPart", true)
		or findNape(model)
		or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart", true)
end

--// Nape patch
do
	local patchedModules = {}

	local function patchTitanModule(moduleScript, titanName)
		local titanModule = safeRequire(moduleScript)
		if not titanModule then
			return
		end

		if patchedModules[titanName] then
			return
		end
		patchedModules[titanName] = true

		local oldRegister = titanModule.Register
		if type(oldRegister) ~= "function" then
			return
		end

		titanModule.Register = function(self, ...)
			if self and self.UtilityHandler then
				local original = self.UtilityHandler.__OriginalCorrectNapeSize or self.UtilityHandler.CorrectNapeSize
				if typeof(original) == "Vector3" then
					self.UtilityHandler.__OriginalCorrectNapeSize = original

					local multiplier = SETTINGS.NapeEnabled and (SETTINGS.NapeMultipliers[titanName] or 1) or 1
					self.UtilityHandler.CorrectNapeSize = original * multiplier
				end
			end

			return oldRegister(self, ...)
		end
	end

	for titanName, _ in pairs(SETTINGS.NapeMultipliers) do
		local moduleScript = titanTypesFolder:FindFirstChild(titanName)
		if moduleScript and moduleScript:IsA("ModuleScript") then
			patchTitanModule(moduleScript, titanName)
		end
	end
end

--// Gear patch
do
	local ODMG = safeRequire(odmgFolder)
	local Grapples = safeRequire(odmgFolder:WaitForChild("Grapples"))

	if ODMG and Grapples then
		local oldGetRange = Grapples.GetRange
		local oldMaxVelocity = Grapples.MaxVelocity
		local oldGetVeloMultiplier = Grapples.GetVeloMultiplier
		local oldGiveVelocity = Grapples.GiveVelocity
		local oldNew = Grapples.new
		local oldReduceGasCount = ODMG.ReduceGasCount
		local grappleObjects = setmetatable({}, { __mode = "k" })

		local function forceODMGBuffs(odmg)
			if not SETTINGS.GearEnabled or not odmg then
				return
			end

			if odmg:GetAttribute("Gas") ~= SETTINGS.Gear.GAS_AMOUNT then
				odmg:SetAttribute("Gas", SETTINGS.Gear.GAS_AMOUNT)
			end

			if odmg:GetAttribute("MaxGas") ~= SETTINGS.Gear.MAX_GAS then
				odmg:SetAttribute("MaxGas", SETTINGS.Gear.MAX_GAS)
			end
		end

		local function forceGrappleNoFloorDrain(grapple)
			if not SETTINGS.GearEnabled or not grapple then
				return
			end

			grapple.GroundHookTension = 0
			grapple.GroundHookEnabled = true
			grapple.dep50Sent = false
			grapple.dep75Sent = false
			grapple.rec50Sent = false
			grapple.rec25Sent = false
			grapple.lastBlacklisted = false
			grapple.lastRayOk = true

			if grapple.Left then
				grapple.Left.PlayerHooking = grapple.Left.PlayerHooking or false
			end

			if grapple.Right then
				grapple.Right.PlayerHooking = grapple.Right.PlayerHooking or false
			end
		end

		Grapples.GetRange = function(self)
			if not SETTINGS.GearEnabled then
				return oldGetRange and oldGetRange(self) or SETTINGS.Gear.RANGE
			end

			local base = SETTINGS.Gear.RANGE

			if oldGetRange then
				local ok, result = pcall(oldGetRange, self)
				if ok and typeof(result) == "number" then
					base = math.max(result, SETTINGS.Gear.RANGE)
				end
			end

			return base
		end

		Grapples.MaxVelocity = function(self, dexterityLevel)
			if not SETTINGS.GearEnabled then
				return oldMaxVelocity and oldMaxVelocity(self, dexterityLevel) or SETTINGS.Gear.MAX_VELOCITY
			end

			local base = SETTINGS.Gear.MAX_VELOCITY

			if oldMaxVelocity then
				local ok, result = pcall(oldMaxVelocity, self, dexterityLevel)
				if ok and typeof(result) == "number" then
					base = math.max(result, SETTINGS.Gear.MAX_VELOCITY)
				end
			end

			return base
		end

		Grapples.GetVeloMultiplier = function(self)
			if not SETTINGS.GearEnabled then
				return oldGetVeloMultiplier and oldGetVeloMultiplier(self) or 1
			end

			local base = 1 + SETTINGS.Gear.VELO_ADD + (SETTINGS.Gear.EXTRA_SPEED_VALUE / 100)

			if oldGetVeloMultiplier then
				local ok, result = pcall(oldGetVeloMultiplier, self)
				if ok and typeof(result) == "number" then
					base = result + SETTINGS.Gear.VELO_ADD + (SETTINGS.Gear.EXTRA_SPEED_VALUE / 100)
				end
			end

			return base
		end

		Grapples.GiveVelocity = function(self, amount, useMultiplier, decayInfo, maxClamp)
			if not SETTINGS.GearEnabled then
				if oldGiveVelocity then
					return oldGiveVelocity(self, amount, useMultiplier, decayInfo, maxClamp)
				end
				return self.BuiltVelocity
			end

			local dexterityLevel = 0
			local okDex, dexResult = pcall(function()
				return self:Client():GetAttribute("Att_Dexterity") - 1
			end)

			if okDex and typeof(dexResult) == "number" then
				dexterityLevel = dexResult
			end

			local maxVelo = SETTINGS.Gear.MAX_VELOCITY
			local okMax, maxResult = pcall(function()
				return self:MaxVelocity(dexterityLevel)
			end)

			if okMax and typeof(maxResult) == "number" then
				maxVelo = maxResult
			end

			local forcedBurst = maxVelo * SETTINGS.Gear.HOOK_VELO_FRACTION

			if maxClamp and typeof(maxClamp) == "number" then
				forcedBurst = math.min(forcedBurst, maxClamp)
			end

			if amount and amount < 0 then
				if oldGiveVelocity then
					return oldGiveVelocity(self, amount, useMultiplier, decayInfo, maxClamp)
				end
				self.BuiltVelocity = math.max((self.BuiltVelocity or 0) + amount, 0)
				return self.BuiltVelocity
			end

			self.BuiltVelocity = math.clamp(forcedBurst, 0, maxVelo)
			return self.BuiltVelocity
		end

		if oldNew then
			Grapples.new = function(...)
				local obj = oldNew(...)

				if obj then
					grappleObjects[obj] = true
					forceGrappleNoFloorDrain(obj)
				end

				if obj and not obj.__PatchedStats then
					obj.__PatchedStats = true

					local oldVariant = obj.GetVariantMultiplier
					if oldVariant then
						obj.GetVariantMultiplier = function(self, ...)
							local result = oldVariant(self, ...)

							if type(result) == "table" then
								local copy = {}
								for k, v in pairs(result) do
									copy[k] = v
								end

								if SETTINGS.GearEnabled then
									copy.HookSpeed = math.max(copy.HookSpeed or 0, SETTINGS.Gear.HOOK_SPEED)
								end

								return copy
							end

							return result
						end
					end
				end

				return obj
			end
		end

		if oldReduceGasCount then
			ODMG.ReduceGasCount = function(self, ...)
				if not SETTINGS.GearEnabled then
					return oldReduceGasCount(self, ...)
				end

				local model = nil
				local ok, result = pcall(function()
					return self:GetModel()
				end)

				if ok then
					model = result
				end

				if model then
					forceODMGBuffs(model)
				end

				return false
			end
		end

		local function applyODMGBuffs()
			if not SETTINGS.GearEnabled then
				return
			end

			local character = player.Character
			if not character then
				return
			end

			local odmg = character:FindFirstChild("ODMG")
			if odmg then
				forceODMGBuffs(odmg)
			end
		end

		local function watchCharacter(character)
			applyODMGBuffs()

			character.ChildAdded:Connect(function(child)
				if child.Name == "ODMG" then
					task.wait()
					forceODMGBuffs(child)
				end
			end)
		end

		if player.Character then
			watchCharacter(player.Character)
		end

		player.CharacterAdded:Connect(function(character)
			watchCharacter(character)
		end)

		RunService.Heartbeat:Connect(function()
			if not SETTINGS.GearEnabled then
				return
			end

			for grapple in pairs(grappleObjects) do
				forceGrappleNoFloorDrain(grapple)
			end

			local ok, active = pcall(function()
				return ODMG:GetActive()
			end)

			if ok and active then
				local ok2, grapple = pcall(function()
					return active:Grapples()
				end)

				if ok2 and grapple then
					grappleObjects[grapple] = true
					forceGrappleNoFloorDrain(grapple)
				end
			end
		end)

		task.spawn(function()
			while true do
				if SETTINGS.GearEnabled then
					local character = player.Character
					if character then
						local odmg = character:FindFirstChild("ODMG")
						if odmg then
							forceODMGBuffs(odmg)
						end
					end
				end
				task.wait(4)
			end
		end)
	end
end

--// Titan ESP
local titanEspByNape = {}

local function removeTitanESPByNape(nape)
	local info = titanEspByNape[nape]
	if not info then
		return
	end
	if info.box then info.box:Destroy() end
	if info.bb then info.bb:Destroy() end
	titanEspByNape[nape] = nil
end

local function makeTitanSelectionBox(part)
	local box = Instance.new("SelectionBox")
	box.Name = "_TitanESP_Box"
	box.Adornee = part
	box.LineThickness = 0.05
	box.Color3 = Color3.fromRGB(0, 170, 255)
	box.SurfaceColor3 = Color3.fromRGB(0, 170, 255)
	box.Transparency = SETTINGS.TitanESPTransparency
	box.SurfaceTransparency = SETTINGS.TitanESPTransparency
	box.Parent = part
	return box
end

local function makeTitanBillboard(part)
	local bb = Instance.new("BillboardGui")
	bb.Name = "_TitanESP_Billboard"
	bb.Adornee = part
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(250, 36)
	bb.StudsOffset = Vector3.new(0, 3.1, 0)
	bb.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = "Info"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.35
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.Text = ""
	label.Parent = bb

	return bb, label
end

local function attachTitanESP(model)
	if not SETTINGS.TitanESPEnabled or not model or not model:IsA("Model") then
		return
	end

	local nape = findNape(model)
	if not nape or titanEspByNape[nape] then
		return
	end

	local box = makeTitanSelectionBox(nape)
	local bb, label = makeTitanBillboard(nape)

	titanEspByNape[nape] = {
		box = box,
		bb = bb,
		label = label,
		model = model,
		nape = nape,
	}

	nape.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeTitanESPByNape(nape)
		end
	end)
end

local function refreshTitanESP()
	for nape in pairs(titanEspByNape) do
		removeTitanESPByNape(nape)
	end

	if SETTINGS.TitanESPEnabled and titanEspFolder then
		for _, titan in ipairs(titanEspFolder:GetChildren()) do
			attachTitanESP(titan)
		end
	end
end

if titanEspFolder and titanEspFolder:IsA("Instance") then
	titanEspFolder.ChildAdded:Connect(function(titan)
		task.wait(0.1)
		attachTitanESP(titan)
	end)

	titanEspFolder.ChildRemoved:Connect(function(titan)
		local nape = findNape(titan)
		if nape then
			removeTitanESPByNape(nape)
		end
	end)
end

--// Character ESP
local characterEspByModel = {}

local function removeCharacterESP(model)
	local info = characterEspByModel[model]
	if not info then
		return
	end
	if info.box then info.box:Destroy() end
	if info.bb then info.bb:Destroy() end
	characterEspByModel[model] = nil
end

local function getCharacterESPInfo(model)
	if not model or not model:IsA("Model") then
		return nil, nil
	end

	local humanoid = model:FindFirstChildWhichIsA("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not humanoid or not root then
		return nil, nil
	end

	return humanoid, root
end

local function makeCharacterSelectionBox(part)
	local box = Instance.new("SelectionBox")
	box.Name = "_CharacterESP_Box"
	box.Adornee = part
	box.LineThickness = 0.05
	box.Color3 = Color3.fromRGB(0, 170, 255)
	box.SurfaceColor3 = Color3.fromRGB(0, 170, 255)
	box.Transparency = SETTINGS.CharacterESPTransparency
	box.SurfaceTransparency = SETTINGS.CharacterESPTransparency
	box.Parent = part
	return box
end

local function makeCharacterBillboard(part)
	local bb = Instance.new("BillboardGui")
	bb.Name = "_CharacterESP_Billboard"
	bb.Adornee = part
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(260, 54)
	bb.StudsOffset = Vector3.new(0, 3.4, 0)
	bb.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = "Info"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.35
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.Text = ""
	label.Parent = bb

	return bb, label
end

local function attachCharacterESP(model)
	if not SETTINGS.CharacterESPEnabled or not charactersFolder then
		return
	end
	if not model or not model:IsA("Model") then
		return
	end
	if characterEspByModel[model] then
		return
	end

	local humanoid, root = getCharacterESPInfo(model)
	if not humanoid or not root then
		return
	end

	local box = makeCharacterSelectionBox(root)
	local bb, label = makeCharacterBillboard(root)

	characterEspByModel[model] = {
		box = box,
		bb = bb,
		label = label,
		model = model,
		root = root,
		humanoid = humanoid,
	}

	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeCharacterESP(model)
		end
	end)
end

local function refreshCharacterESP()
	for model in pairs(characterEspByModel) do
		removeCharacterESP(model)
	end

	if SETTINGS.CharacterESPEnabled and charactersFolder then
		for _, model in ipairs(charactersFolder:GetChildren()) do
			attachCharacterESP(model)
		end
	end
end

if charactersFolder then
	charactersFolder.ChildAdded:Connect(function(model)
		task.wait(0.15)
		attachCharacterESP(model)
	end)

	charactersFolder.ChildRemoved:Connect(function(model)
		removeCharacterESP(model)
	end)
end

