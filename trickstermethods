local function getFirstShifterSample()
	if not charactersFolder then
		return nil, nil, nil
	end

	for _, model in ipairs(charactersFolder:GetChildren()) do
		if isShifterModel(model) then
			local nape = findNape(model)
			local eyes = findEyes(model)
			local firstEye = eyes[1]
			return model, nape, firstEye
		end
	end

	return nil, nil, nil
end

local function updateShifterPreview()
	local eyeScale = math.clamp(SETTINGS.ShifterEyesMultiplier, 1, 8)
	local napeScale = math.clamp(SETTINGS.ShifterNapeMultiplier, 1, 8)

	leftEyePreview.Size = UDim2.new(0, 18 * eyeScale, 0, 10 * eyeScale)
	rightEyePreview.Size = UDim2.new(0, 18 * eyeScale, 0, 10 * eyeScale)

	napePreview.Size = UDim2.new(0, 28 * napeScale, 0, 18 * napeScale)

	local model, nape, eye = getFirstShifterSample()
	local text = {}

	table.insert(text, "Live Sample:")
	table.insert(text, "Shifter Found: " .. (model and model.Name or "None"))
	table.insert(text, "")
	table.insert(text, "Nape Multiplier: " .. tostring(SETTINGS.ShifterNapeMultiplier))
	table.insert(text, "Eyes Multiplier: " .. tostring(SETTINGS.ShifterEyesMultiplier))
	table.insert(text, "")

	if nape then
		table.insert(text, "Nape Size: " .. tostring(nape.Size))
	else
		table.insert(text, "Nape Size: N/A")
	end

	if eye then
		table.insert(text, "Eye Size: " .. tostring(eye.Size))
	else
		table.insert(text, "Eye Size: N/A")
	end

	shifterDataLabel.Text = table.concat(text, "\n")
end

