-- Dragging
topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		uiState.dragging = true
		uiState.dragStart = input.Position
		uiState.startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				uiState.dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if uiState.dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - uiState.dragStart
		main.Position = UDim2.new(
			uiState.startPos.X.Scale,
			uiState.startPos.X.Offset + delta.X,
			uiState.startPos.Y.Scale,
			uiState.startPos.Y.Offset + delta.Y
		)
	end
end)

-- Keybind capture + ESP toggles
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if uiState.capturingKeybind then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local setter = uiState.capturingKeybind._setter
			if setter then
				setter(input.KeyCode)
			end
			uiState.capturingKeybind = nil
			refreshTitanKeybindButton()
			refreshCharacterKeybindButton()
			refreshRefillKeybindButton()
		end
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == SETTINGS.TitanESPKeybind then
			SETTINGS.TitanESPEnabled = not SETTINGS.TitanESPEnabled
			refreshTitanESP()
			refreshTitanEspToggle()
		elseif input.KeyCode == SETTINGS.CharacterESPKeybind then
			SETTINGS.CharacterESPEnabled = not SETTINGS.CharacterESPEnabled
			refreshCharacterESP()
			refreshCharacterEspToggle()
		elseif input.KeyCode == SETTINGS.RefillESPKeybind then
			SETTINGS.RefillESPEnabled = not SETTINGS.RefillESPEnabled
			refreshRefillESP()
			refreshRefillEspToggle()
		end
	end
end)

