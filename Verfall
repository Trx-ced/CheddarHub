local function setWindowOpen(open)
	state.Open = open
	main.Visible = open
end

closeButton.MouseButton1Click:Connect(function()
	setWindowOpen(false)
end)

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		state.Dragging = true
		state.DragStart = input.Position
		state.StartPosition = main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				state.Dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if state.Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - state.DragStart
		main.Position = UDim2.new(
			state.StartPosition.X.Scale,
			state.StartPosition.X.Offset + delta.X,
			state.StartPosition.Y.Scale,
			state.StartPosition.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if state.Capturing and input.UserInputType == Enum.UserInputType.Keyboard then
		local setter = state.CaptureSetter
		local refresh = state.CaptureRefresh
		state.Capturing = nil
		state.CaptureSetter = nil
		state.CaptureRefresh = nil
		if setter then
			setter(input.KeyCode)
		end
		if refresh then
			refresh()
		end
		refreshToggleBind()
		refreshRefillBind()
		refreshRawBandageBind()
		refreshBandageRemovalBind()
		return
	end

	if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	if input.KeyCode == Config.ToggleUIKey then
		setWindowOpen(not state.Open)
	elseif input.KeyCode == Config.RefillKey then
		instantRefillAll()
	elseif input.KeyCode == Config.RawBandageKey then
		fireRawBandageHeal()
	elseif input.KeyCode == Config.BandageRemovalMacroKey then
		task.spawn(executeBandageRemoval)
	end
end)

if Config.BladeModsEnabled then
	task.spawn(installBladeMods)
end

