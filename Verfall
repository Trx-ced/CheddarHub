local function shouldSaveConfigKey(key)
	if typeof(key) ~= "string" then
		return false
	end
	if key == "SelectedConfigName" or key == "AutoLoadConfig" then
		return false
	end
	return not key:find("Hook") and not key:find("Modified")
end

local function sanitizeConfigName(name)
	name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
	name = name:gsub("[^%w_%-%s]", ""):gsub("%s+", "_")
	if name == "" then
		name = "default"
	end
	return name
end

local function getNamedConfigFile(name)
	return CONFIG_FOLDER .. "/" .. sanitizeConfigName(name) .. ".json"
end

local function getSavedConfigNames()
	local names = {}
	if not listfiles or not isfolder or not isfolder(CONFIG_FOLDER) then
		return names
	end

	local success, files = pcall(listfiles, CONFIG_FOLDER)
	if not success or typeof(files) ~= "table" then
		return names
	end

	for _, filePath in ipairs(files) do
		local fileName = tostring(filePath):match("[^/\\]+$")
		local name = fileName and fileName:match("^(.*)%.json$")
		if name and name ~= "autosave" and name ~= "settings" then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

local function encodeConfigValue(value)
	local valueType = typeof(value)

	if valueType == "Vector3" then
		return {
			__type = "Vector3",
			x = value.X,
			y = value.Y,
			z = value.Z,
		}
	end

	if valueType == "EnumItem" then
		local enumType, enumName = tostring(value):match("^Enum%.([^%.]+)%.(.+)$")
		return {
			__type = "EnumItem",
			enumType = enumType,
			enumName = enumName,
		}
	end

	if valueType == "table" then
		local encoded = {}
		for key, item in pairs(value) do
			encoded[key] = encodeConfigValue(item)
		end
		return encoded
	end

	if valueType == "boolean" or valueType == "number" or valueType == "string" then
		return value
	end

	return nil
end

local function decodeConfigValue(value)
	if typeof(value) ~= "table" then
		return value
	end

	if value.__type == "Vector3" then
		return Vector3.new(tonumber(value.x) or 0, tonumber(value.y) or 0, tonumber(value.z) or 0)
	end

	if value.__type == "EnumItem" then
		local enumType = value.enumType and Enum[value.enumType]
		if enumType and value.enumName and enumType[value.enumName] then
			return enumType[value.enumName]
		end
		return nil
	end

	local decoded = {}
	for key, item in pairs(value) do
		decoded[key] = decodeConfigValue(item)
	end
	return decoded
end

local function mergeConfig(target, saved)
	for key, value in pairs(saved) do
		local decoded = decodeConfigValue(value)
		if typeof(decoded) == "table" and typeof(target[key]) == "table" and decoded.__type == nil then
			mergeConfig(target[key], decoded)
		elseif decoded ~= nil then
			target[key] = decoded
		end
	end
end

local function buildSavedConfig(source)
	local saved = {}
	for key, value in pairs(source) do
		if shouldSaveConfigKey(key) then
			local encoded = encodeConfigValue(value)
			if encoded ~= nil then
				saved[key] = encoded
			end
		end
	end
	return saved
end

local function SaveConfig(configFile)
	if not writefile or not makefolder then
		warn("[CheddarHub Config] Your executor does not support file saving.")
		return false
	end

	configFile = configFile or CONFIG_AUTOSAVE_FILE
	syncConfigInputs()

	local success, err = pcall(function()
		if isfolder then
			if not isfolder(CONFIG_FOLDER) then
				makefolder(CONFIG_FOLDER)
			end
		else
			makefolder(CONFIG_FOLDER)
		end
		writefile(configFile, HttpService:JSONEncode(buildSavedConfig(Config)))
	end)

	if not success then
		warn("[CheddarHub Config] Save failed:", err)
	end

	return success
end

local function SaveConfigSettings()
	if not writefile or not makefolder then
		return false
	end

	local success = pcall(function()
		if isfolder then
			if not isfolder(CONFIG_FOLDER) then
				makefolder(CONFIG_FOLDER)
			end
		else
			makefolder(CONFIG_FOLDER)
		end
		writefile(CONFIG_SETTINGS_FILE, HttpService:JSONEncode({
			SelectedConfigName = sanitizeConfigName(Config.SelectedConfigName),
			AutoLoadConfig = Config.AutoLoadConfig == true,
		}))
	end)

	return success
end

local function LoadConfigSettings()
	if not readfile or not isfile or not isfile(CONFIG_SETTINGS_FILE) then
		return false
	end

	local success, settings = pcall(function()
		return HttpService:JSONDecode(readfile(CONFIG_SETTINGS_FILE))
	end)

	if success and typeof(settings) == "table" then
		Config.SelectedConfigName = sanitizeConfigName(settings.SelectedConfigName)
		Config.AutoLoadConfig = settings.AutoLoadConfig == true
		return true
	end

	return false
end

local function LoadConfig(configFile)
	configFile = configFile or CONFIG_AUTOSAVE_FILE

	if not readfile or not isfile or not isfile(configFile) then
		return false
	end

	local success, saved = pcall(function()
		return HttpService:JSONDecode(readfile(configFile))
	end)

	if success and typeof(saved) == "table" then
		mergeConfig(Config, saved)
		return true
	end

	warn("[CheddarHub Config] Load failed:", saved)
	return false
end

