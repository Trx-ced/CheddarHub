local function runObbyOnce()
	task.spawn(function()
		local obbyContainer = workspace:FindFirstChild("TC") or workspace
		local endPart = obbyContainer:FindFirstChild("ObbyExamEnd")
		local checkpoints = {}
		for _, part in ipairs(obbyContainer:GetDescendants()) do
			if part:IsA("BasePart") and (part.Name:lower():find("checkpoint") or part.Name:lower():find("stage")) then
				table.insert(checkpoints, part)
			end
		end
		table.sort(checkpoints, function(a, b)
			local numA = tonumber(a.Name:match("%d+")) or 0
			local numB = tonumber(b.Name:match("%d+")) or 0
			if numA ~= numB then
				return numA < numB
			end
			return a.Name < b.Name
		end)
		local totalNodes = #checkpoints + 1
		local calculatedDelay = 28 / math.max(totalNodes, 1)
		local character = localPlayer.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart then
			return
		end
		for _, checkpoint in ipairs(checkpoints) do
			rootPart.CFrame = checkpoint.CFrame + Vector3.new(0, 3, 0)
			task.wait(calculatedDelay)
		end
		if endPart then
			rootPart.CFrame = endPart.CFrame + Vector3.new(0, 3, 0)
			task.wait(calculatedDelay)
			local clientFramework = ReplicatedStorage:WaitForChild("ClientFramework", 5)
			local network = clientFramework and clientFramework:WaitForChild("Network", 5)
			local obbyRemote = network and network:WaitForChild("ObbyTest", 5)
			if obbyRemote then
				obbyRemote:FireServer("EndTest")
			end
		end
	end)
end

local function runSpeedTestOnce()
	task.spawn(function()
		local container = workspace:FindFirstChild("TC") or workspace
		local endPart = container:FindFirstChild("SpeedExamEnd")
		local checkpoints = {}
		for _, part in ipairs(container:GetDescendants()) do
			if part:IsA("BasePart") and (part.Name:lower():find("checkpoint") or part.Name:lower():find("gate") or part.Name:lower():find("stage")) then
				table.insert(checkpoints, part)
			end
		end
		table.sort(checkpoints, function(a, b)
			local numA = tonumber(a.Name:match("%d+")) or 0
			local numB = tonumber(b.Name:match("%d+")) or 0
			if numA ~= numB then
				return numA < numB
			end
			return a.Name < b.Name
		end)
		if endPart then
			table.insert(checkpoints, endPart)
		end
		local character = localPlayer.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or #checkpoints == 0 then
			return
		end
		local timePerNode = math.max(tonumber(Config.SpeedTestTime) or 16.5, 1) / #checkpoints
		rootPart.Anchored = true
		local ok = pcall(function()
			local tweenInfo = TweenInfo.new(timePerNode, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
			for _, node in ipairs(checkpoints) do
				local tween = TweenService:Create(rootPart, tweenInfo, {
					CFrame = node.CFrame + Vector3.new(0, 3, 0),
				})
				tween:Play()
				tween.Completed:Wait()
			end
		end)
		rootPart.Anchored = false
		if ok then
			task.wait(0.1)
			local clientFramework = ReplicatedStorage:WaitForChild("ClientFramework", 5)
			local network = clientFramework and clientFramework:WaitForChild("Network", 5)
			local speedRemote = network and network:WaitForChild("SpeedTest", 5)
			if speedRemote then
				speedRemote:FireServer("EndTest")
			end
		end
	end)
end

local musketBullseyeOriginals = {}

local function updateMusketBullseyes()
	local targetTags = {
		"BullsEye Horizontal",
		"BullsEye Vertical",
		"BullsEye PopUp",
	}
	for _, tagName in ipairs(targetTags) do
		for _, target in ipairs(CollectionService:GetTagged(tagName)) do
			local bullsEye = target:FindFirstChild("BullsEye")
			if bullsEye and bullsEye:IsA("BasePart") then
				if not musketBullseyeOriginals[bullsEye] then
					musketBullseyeOriginals[bullsEye] = {
						Size = bullsEye.Size,
						CanCollide = bullsEye.CanCollide,
						Transparency = bullsEye.Transparency,
					}
				end
				local highlight = bullsEye:FindFirstChild("MusketBullseyeHighlight")
				if Config.MusketBullseyeEnabled then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "MusketBullseyeHighlight"
						highlight.Adornee = bullsEye
						highlight.FillColor = Color3.fromRGB(255, 0, 0)
						highlight.FillTransparency = 0.4
						highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						highlight.Parent = bullsEye
					end
					bullsEye.Size = Config.MusketBullseyeSize
					bullsEye.CanCollide = false
					bullsEye.Transparency = 0.7
				else
					local original = musketBullseyeOriginals[bullsEye]
					if original then
						bullsEye.Size = original.Size
						bullsEye.CanCollide = original.CanCollide
						bullsEye.Transparency = original.Transparency
					end
					if highlight then
						highlight:Destroy()
					end
				end
			end
		end
	end
end

task.spawn(function()
	updateMusketBullseyes()
	while task.wait(2) do
		if Config.MusketBullseyeEnabled then
			updateMusketBullseyes()
		end
	end
end)

