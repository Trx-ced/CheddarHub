local function notifyBandageRemoval(clientFramework, text)
	if clientFramework and type(clientFramework.Notification) == "function" then
		clientFramework.Notification("Notification", text)
	else
		warn("[Bandage Removal Macro]", text)
	end
end

local function executeBandageRemoval()
	if bandageRemovalProcessing or not Config.BandageRemovalMacroEnabled then
		return
	end

	bandageRemovalProcessing = true

	local ok, err = pcall(function()
		local data = getBandageRemovalData()
		if not data then
			return
		end

		local clientFramework = data.ClientFramework
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")

		if not character or not humanoid or not rootPart or humanoid.Health <= 0 then
			return
		end

		local mouseTarget = data.Mouse.Target
		local targetCharacter = nil
		local targetPlayer = nil

		if mouseTarget and (mouseTarget.Position - rootPart.Position).Magnitude < 5 then
			targetCharacter = clientFramework.CheckForHumanoid(mouseTarget)

			if targetCharacter and targetCharacter ~= character then
				targetPlayer = clientFramework.GetPlayerFromCharacter(targetCharacter)

				if not targetCharacter:GetAttribute("Bandageable") then
					targetCharacter = nil
					targetPlayer = nil
				end
			end
		end

		if targetPlayer and targetCharacter and (targetCharacter:GetAttribute("BandageCount") or 0) > 0 then
			if CollectionService:HasTag(targetCharacter, "Reclusive") then
				notifyBandageRemoval(clientFramework, "They don't need my help.")
				return
			end

			local aidRequested = targetPlayer:GetAttribute("AidRequests") or false

			if aidRequested then
				local requestPayload = { character, Distance = 5 }
				local promptString = ("%s is requesting to bandage you!"):format(clientFramework.GetLoreName())

				if clientFramework.SendPlayerRequest(targetPlayer, promptString, { "Accept", "Decline" }, "Bandage", requestPayload) == "Accept" then
					if not targetCharacter:GetAttribute("Bandageable") then
						return notifyBandageRemoval(clientFramework, "Someone's already working on them.")
					end

					if mouseTarget and (mouseTarget.Position - rootPart.Position).Magnitude > 5 then
						return notifyBandageRemoval(clientFramework, "They're too far away.")
					end

					data.BandageFunction:InvokeServer("RemoveOther", targetPlayer)
				end
			else
				data.BandageFunction:InvokeServer("RemoveOther", targetPlayer)
			end
		elseif (character:GetAttribute("BandageCount") or 0) > 0 then
			local animator = humanoid:FindFirstChildOfClass("Animator")
			local animationAsset = clientFramework.ReplicatedAssets
				and clientFramework.ReplicatedAssets:FindFirstChild("Animations")
				and clientFramework.ReplicatedAssets.Animations:FindFirstChild("Tools")
				and clientFramework.ReplicatedAssets.Animations.Tools:FindFirstChild("Bandage")

			if animator and animationAsset and animationAsset:FindFirstChild("SelfHeal1") then
				local selfHealAnim = animator:LoadAnimation(animationAsset.SelfHeal1)
				selfHealAnim:Play()

				pcall(function()
					if data.BandageSFX and data.BandageSFX:FindFirstChild("Heal") then
						clientFramework.SimpleFx.GlobalSound(rootPart, data.BandageSFX.Heal)
					end
				end)

				pcall(function()
					clientFramework.PlayerObject:AddAttribute("HotbarDisabled")
				end)

				selfHealAnim.Stopped:Wait()

				pcall(function()
					clientFramework.PlayerObject:RemoveAttribute("HotbarDisabled")
				end)
			end

			data.BandageEvent:FireServer("SelfRemove", humanoid)
		else
			notifyBandageRemoval(clientFramework, "No valid bandage targets detected.")
		end
	end)

	if not ok then
		warn("[Bandage Removal Macro]", err)
	end

	bandageRemovalProcessing = false
end

local bladeMods = {
	Patched = false,
	Target = nil,
	OriginalOnHit = nil,
}

local function installBladeMods()
	if bladeMods.Patched then
		return
	end

	if type(getgc) ~= "function" then
		return
	end

	for _, obj in pairs(getgc(true)) do
		if type(obj) == "table" and rawget(obj, "OnHit") and rawget(obj, "CalculateDura") and type(obj.OnHit) == "function" then
			obj.__CheddarOriginalOnHit = obj.__CheddarOriginalOnHit or obj.OnHit
			bladeMods.Target = obj
			bladeMods.OriginalOnHit = obj.__CheddarOriginalOnHit

			if obj.OnHit ~= obj.__CheddarWrappedOnHit or obj.__CheddarWrappedOnHitVersion ~= 2 then
				obj.__CheddarWrappedOnHit = function(self, target, hitPart, enemyType, ...)
					if not Config.BladeModsEnabled then
						return obj.__CheddarOriginalOnHit(self, target, hitPart, enemyType, ...)
					end

					if self.UnmodifiedBaseDamage == nil then
						self.UnmodifiedBaseDamage = self.Damage
					end

					local trueBase = self.UnmodifiedBaseDamage
					if type(trueBase) == "number" then
						if (enemyType == "Titan" or enemyType == "TitanDummy") and Config.BladeTitanMultiplierEnabled then
							self.Damage = trueBase * math.max(tonumber(Config.BladeTitanMultiplier) or 1, 1)
						elseif enemyType == "Human" and Config.BladeHumanMultiplierEnabled then
							self.Damage = trueBase * math.max(tonumber(Config.BladeHumanMultiplier) or 1, 1)
						else
							self.Damage = trueBase
						end
					end

					local results = table.pack(pcall(obj.__CheddarOriginalOnHit, self, target, hitPart, enemyType, ...))
					self.Damage = trueBase
					if not results[1] then
						error(results[2])
					end
					return unpack(results, 2, results.n)
				end
				obj.__CheddarWrappedOnHitVersion = 2
				obj.OnHit = obj.__CheddarWrappedOnHit
			end

			bladeMods.Patched = true
			break
		end
	end
end

