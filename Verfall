	label(parent, y, text)
	local button = mk("TextButton", {
		Parent = parent,
		Position = UDim2.new(1, -184, 0, y + 2),
		Size = UDim2.fromOffset(162, 28),
		BackgroundColor3 = COLORS.INPUT,
		BorderSizePixel = 0,
		Text = keyName(getter()),
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
		ZIndex = 5,
	})
	addCorner(button, 9)
	addStroke(button, COLORS.STROKE_SOFT, 0.18)
	local function refresh()
		if state.Capturing == button then
			button.Text = "PRESS A KEY"
			button.BackgroundColor3 = COLORS.ON
		else
			button.Text = keyName(getter())
			button.BackgroundColor3 = COLORS.INPUT
		end
	end
	button.MouseButton1Click:Connect(function()
		state.Capturing = button
		state.CaptureSetter = setter
		state.CaptureRefresh = refresh
		refresh()
	end)
	refresh()
	return refresh
end

