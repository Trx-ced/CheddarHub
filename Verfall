local function mk(className, props)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	return object
end

local function addCorner(object, radius)
	mk("UICorner", {
		Parent = object,
		CornerRadius = UDim.new(0, radius),
	})
end

local function addStroke(object, color, transparency)
	mk("UIStroke", {
		Parent = object,
		Color = color,
		Thickness = 1,
		Transparency = transparency or 0,
	})
end

local function addGradient(object, firstColor, secondColor)
	local gradient = mk("UIGradient", {
		Parent = object,
		Rotation = 90,
	})
	gradient.Color = ColorSequence.new(firstColor, secondColor)
end

local function keyName(keyCode)
	return tostring(keyCode):gsub("Enum.KeyCode.", "")
end

local function parseVector(text, fallback)
	local parts = string.split(text, ",")
	if #parts ~= 3 then
		return fallback
	end
	return Vector3.new(tonumber(parts[1]) or fallback.X, tonumber(parts[2]) or fallback.Y, tonumber(parts[3]) or fallback.Z)
end

