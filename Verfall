local function createStatToggleBox(parent, y, statName)
	label(parent, y, statName)
	local box = mk("TextBox", {
		Parent = parent,
		Position = UDim2.new(1, -222, 0, y + 2),
		Size = UDim2.fromOffset(110, 28),
		BackgroundColor3 = COLORS.INPUT,
		BorderSizePixel = 0,
		Text = tostring(Config.CustomStats[statName]),
		TextColor3 = COLORS.TEXT,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		TextSize = 12,
		ZIndex = 5,
	})
	addCorner(box, 9)
	addStroke(box, COLORS.STROKE_SOFT, 0.18)
	statValueBoxes[statName] = box
	box.FocusLost:Connect(function()
		local value = tonumber(box.Text)
		if value then
			Config.CustomStats[statName] = value
		end
		box.Text = tostring(Config.CustomStats[statName])
		SaveConfig()
	end)

	local button = mk("TextButton", {
		Parent = parent,
		Position = UDim2.new(1, -104, 0, y + 2),
		Size = UDim2.fromOffset(82, 27),
		BackgroundColor3 = COLORS.OFF,
		BorderSizePixel = 0,
		Text = "",
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
		ZIndex = 5,
	})
	addCorner(button, 9)

	local function refresh()
		local enabled = Config.CustomStatsEnabled[statName] == true
		box.Text = tostring(Config.CustomStats[statName])
		button.Text = enabled and "ON" or "OFF"
		TweenService:Create(button, TweenInfo.new(0.14), {
			BackgroundColor3 = enabled and COLORS.ON or COLORS.OFF,
		}):Play()
	end

	button.MouseButton1Click:Connect(function()
		Config.CustomStatsEnabled[statName] = Config.CustomStatsEnabled[statName] ~= true
		refresh()
		SaveConfig()
	end)

	refresh()
	table.insert(configRefreshers, refresh)
	return refresh
end

local function createKeybind(parent, y, text, getter, setter)
	label(parent, y, text)
	local button = mk("TextButton", {
		Parent = parent,
		Position = UDim2.new(1, -184, 0, y + 2),
		Size = UDim2.fromOffset(162, 28),
		BackgroundColor3 = COLORS.INPUT,
		BorderSizePixel = 0,
		Text = keyName(getter()),
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
		ZIndex = 5,
	})
	addCorner(button, 9)
	addStroke(button, COLORS.STROKE_SOFT, 0.18)
	local function refresh()
		if state.Capturing == button then
			button.Text = "PRESS A KEY"
			button.BackgroundColor3 = COLORS.ON
		else
			button.Text = keyName(getter())
			button.BackgroundColor3 = COLORS.INPUT
		end
	end
	button.MouseButton1Click:Connect(function()
		state.Capturing = button
		state.CaptureSetter = setter
		state.CaptureRefresh = refresh
		refresh()
	end)
	refresh()
	table.insert(configRefreshers, refresh)
	return refresh
end

