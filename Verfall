local function applyTitanExpansion(titanModel)
	if not titanModel:IsA("Model") then
		return
	end

	local damagePoints = titanModel:WaitForChild("DamagePoints", 5)
	local root = titanModel:WaitForChild("HumanoidRootPart", 5) or titanModel:WaitForChild("Head", 5)
	if not damagePoints or not root then
		return
	end

	local function configurePart(part, size, offset)
		if not part or not part:IsA("BasePart") then
			return
		end
		for _, obj in ipairs(part:GetDescendants()) do
			if obj:IsA("JointInstance") or obj:IsA("Weld") then
				obj:Destroy()
			end
		end
		part.Size = size
		part.CanCollide = false
		part.CFrame = root.CFrame * CFrame.new(offset)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end

	if Config.NapeEnabled then
		configurePart(damagePoints:WaitForChild("Nape", 5), Config.NapeSize, Config.NapeOffset)
	end

	if Config.EyeEnabled then
		local eyes = damagePoints:FindFirstChild("Eyes") or damagePoints:FindFirstChild("Eye")
		if eyes then
			if eyes:IsA("BasePart") then
				configurePart(eyes, Config.EyeSize, Config.EyeOffset)
			else
				for _, eye in ipairs(eyes:GetDescendants()) do
					if eye:IsA("BasePart") then
						configurePart(eye, Config.EyeSize, Config.EyeOffset)
					end
				end
			end
		end
	end
end

local function stripPhysics(part)
	if Config.NullifyEnabled and part:IsA("BasePart") then
		part.Size = Vector3.new(0, 0, 0)
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
	end
end

local function monitorFolder(folder)
	for _, part in ipairs(folder:GetChildren()) do
		stripPhysics(part)
	end
	folder.ChildAdded:Connect(stripPhysics)
end

local function optimizeTitanNullify(titanModel)
	if not titanModel:IsA("Model") then
		return
	end
	task.spawn(function()
		local hitboxes = titanModel:WaitForChild("Hitboxes", 5)
		if hitboxes then
			monitorFolder(hitboxes)
		end
	end)
	task.spawn(function()
		local detectors = titanModel:WaitForChild("Detectors", 5)
		if detectors then
			monitorFolder(detectors)
		end
	end)
end

