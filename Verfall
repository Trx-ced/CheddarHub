	local bandageFunction = clientFramework.ServerFunction and clientFramework.ServerFunction("Bandage")

	if not bandageEvent or not bandageFunction then
		return nil
	end

	bandageRemovalData = {
		ClientFramework = clientFramework,
		BandageEvent = bandageEvent,
		BandageFunction = bandageFunction,
		BandageSFX = clientFramework.ReplicatedAssets
			and clientFramework.ReplicatedAssets:FindFirstChild("SFX")
			and clientFramework.ReplicatedAssets.SFX:FindFirstChild("Tools")
			and clientFramework.ReplicatedAssets.SFX.Tools:FindFirstChild("Bandage"),
		Mouse = localPlayer:GetMouse(),
	}

