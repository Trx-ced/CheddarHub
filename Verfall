local function lockBandageCount(character)
	if not character then
		return
	end
	if Config.BandageEnabled then
		character:SetAttribute("BandageCount", 1)
	end
	character:GetAttributeChangedSignal("BandageCount"):Connect(function()
		if Config.BandageEnabled and character:GetAttribute("BandageCount") ~= 1 then
			character:SetAttribute("BandageCount", 1)
		end
	end)
end

