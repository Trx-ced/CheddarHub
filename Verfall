local function bypassBandageCount(character)
	if not character then
		return
	end
	character:SetAttribute("BandageCount", 0)
	character:GetAttributeChangedSignal("BandageCount"):Connect(function()
		if Config.BandageEnabled and character:GetAttribute("BandageCount") > 0 then
			character:SetAttribute("BandageCount", 0)
		end
	end)
end

