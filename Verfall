local function updateTitanDummyLabel(dummy, label)
	if not label then
		return
	end
	if Config.TitanDummyStatusEnabled then
		if dummy:GetAttribute("Hit") == true then
			label.Text = Config.TitanDummyCountdownEnabled and "DEAD" or "DEAD"
			label.TextColor3 = Color3.fromRGB(255, 50, 50)
		else
			label.Text = "ALIVE"
			label.TextColor3 = Color3.fromRGB(0, 255, 127)
		end
		label.Visible = true
	else
		label.Visible = false
