	local entities = world:FindFirstChild("Entities")
	return world:FindFirstChild("Characters")
		or world:FindFirstChild("PlayerCharacters")
		or (entities and entities:FindFirstChild("PlayerCharacters"))
		or workspace:FindFirstChild("PlayerCharacters")
		or workspace:FindFirstChild("Characters")
end

local function getCharacterFolders()
	local folders = {}
	local seen = {}
	local world = workspace:FindFirstChild("World")
	local entities = world and world:FindFirstChild("Entities")

	local function addFolder(folder)
		if folder and not seen[folder] then
			seen[folder] = true
			folders[#folders + 1] = folder
		end
	end

	addFolder(world and world:FindFirstChild("Characters"))
	addFolder(world and world:FindFirstChild("PlayerCharacters"))
	addFolder(entities and entities:FindFirstChild("PlayerCharacters"))
	addFolder(workspace:FindFirstChild("PlayerCharacters"))
	addFolder(workspace:FindFirstChild("Characters"))

	return folders
end

local function getPlayerTeam(player)
	if not player then
		return nil
	end
	local teamAttribute = player:GetAttribute("Team")
	if teamAttribute and teamAttribute ~= "" then
		return tostring(teamAttribute)
	end
	if player.Team then
		return player.Team.Name
	end
	return nil
end

local function readTextOrValue(object)
	if not object then
		return nil
	end

	local okValue, value = pcall(function()
		return object.Value
	end)
	if okValue and value ~= nil and tostring(value) ~= "" then
		return tostring(value)
	end

	local okText, text = pcall(function()
		return object.Text
	end)
	if okText and text ~= nil and tostring(text) ~= "" then
		return tostring(text)
	end

	return nil
end

local function getLocalProfileBranch()
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	local mainMenu = playerGui and playerGui:FindFirstChild("MainMenu")
	local menuFrame = mainMenu and mainMenu:FindFirstChild("MenuFrame")
	local frames = menuFrame and menuFrame:FindFirstChild("Frames")
	local profile = frames and frames:FindFirstChild("Profile")
	local profileFrame = profile and profile:FindFirstChild("Profile")
	local information = profileFrame and profileFrame:FindFirstChild("Information")
	local list = information and information:FindFirstChild("List")
	local branch = list and list:FindFirstChild("Branch")

	return readTextOrValue(branch)
end

local function findTeamNameFromLeaderboardRow(row)
	if not row then
		return nil
	end

	local scrollingFrame = row.Parent
	if not scrollingFrame then
		return nil
	end

	local teamLayoutOrder = row.LayoutOrder - 1

	for _, sibling in ipairs(scrollingFrame:GetChildren()) do
		if sibling.Name:sub(1, 5) == "Team_" and sibling.LayoutOrder == teamLayoutOrder then
			local teamName = sibling:FindFirstChild("TeamName", true)
			return readTextOrValue(teamName) or sibling.Name:gsub("^Team_", "")
		end
	end

	return nil
end

local function getCharacterTeamFromLeaderboard(characterModel, targetPlayer, loreName)
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if not playerGui or not characterModel then
		return nil
	end

	local possibleRowNames = {}
	if targetPlayer then
		possibleRowNames[#possibleRowNames + 1] = "Player_" .. targetPlayer.Name
	end
	possibleRowNames[#possibleRowNames + 1] = "Player_" .. characterModel.Name

	for _, rowName in ipairs(possibleRowNames) do
		if rowName then
			local row = playerGui:FindFirstChild(rowName, true)
			local teamName = findTeamNameFromLeaderboardRow(row)
			if teamName then
				return teamName
			end
		end
	end

	local targetLoreName = loreName or characterModel:GetAttribute("LoreName")
	if targetLoreName ~= nil and tostring(targetLoreName) ~= "" then
		targetLoreName = tostring(targetLoreName)

		for _, object in ipairs(playerGui:GetDescendants()) do
			if object.Name == "PlayerName" and readTextOrValue(object) == targetLoreName then
				local row = object:FindFirstAncestorWhichIsA("Frame")
				local teamName = findTeamNameFromLeaderboardRow(row)
				if teamName then
					return teamName
				end
			end
		end
	end

	return nil
end

local function getCharacterTeam(targetPlayer, characterModel)
	local uiTeam = getCharacterTeamFromLeaderboard(characterModel, targetPlayer)
	if uiTeam then
		return uiTeam
	end

	if targetPlayer then
		local playerTeam = getPlayerTeam(targetPlayer)
		if playerTeam then
			return playerTeam
		end
	end

	if characterModel then
		for _, attributeName in ipairs({ "Team", "Faction", "Regiment" }) do
			local value = characterModel:GetAttribute(attributeName)
			if value ~= nil and tostring(value) ~= "" then
				return tostring(value)
			end
		end

		for _, object in ipairs(characterModel:GetDescendants()) do
			local name = object.Name:lower()
			if name:find("team") or name:find("faction") or name:find("regiment") then
				local value = readTextOrValue(object)
				if value then
					return value
				end
			end
		end
	end

	return nil
end

local function isSameTeam(playerA, playerB, characterModelB)
	local teamA = getPlayerTeam(playerA) or getLocalProfileBranch()
	local teamB = getCharacterTeamFromLeaderboard(characterModelB, playerB) or getCharacterTeam(playerB, characterModelB)
	return teamA and teamB and teamA == teamB
end

local function getClosestPlayerToMouse()
	if not Config.AimAssistEnabled then
		return nil
	end
	local character = localPlayer.Character
	local charactersFolder = getCharactersFolder()
	local camera = workspace.CurrentCamera
	if not character or not charactersFolder or not camera then
		return nil
	end
	local mouseLocation = UserInputService:GetMouseLocation()
	local closestPart
	local shortestDistance = math.huge
	for _, charModel in ipairs(charactersFolder:GetChildren()) do
		if charModel:IsA("Model") and charModel ~= character then
			local targetPlayer = Players:FindFirstChild(charModel.Name)
			local humanoid = charModel:FindFirstChildOfClass("Humanoid")
			local targetPart = charModel:FindFirstChild("Head") or charModel:FindFirstChild("HumanoidRootPart")
			if not (Config.AimAssistTeamCheck and isSameTeam(localPlayer, targetPlayer, charModel)) and targetPart and humanoid and humanoid.Health > 0 then
				local screenPosition, onScreen = camera:WorldToViewportPoint(targetPart.Position)
				if onScreen then
					local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - mouseLocation).Magnitude
					if distance < shortestDistance and (not Config.FOVEnabled or distance <= Config.FOVRadius) then
						shortestDistance = distance
						closestPart = targetPart
					end
				end
			end
		end
	end
	return closestPart
end

