local function createToggle(parent, y, text, getter, setter)
	label(parent, y, text)
	local button = mk("TextButton", {
		Parent = parent,
		Position = UDim2.new(1, -104, 0, y + 2),
		Size = UDim2.fromOffset(82, 27),
		BackgroundColor3 = COLORS.OFF,
		BorderSizePixel = 0,
		Text = "",
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
		ZIndex = 5,
	})
	addCorner(button, 9)
	local function refresh()
		local enabled = getter()
		button.Text = enabled and "ON" or "OFF"
		TweenService:Create(button, TweenInfo.new(0.14), {
			BackgroundColor3 = enabled and COLORS.ON or COLORS.OFF,
		}):Play()
	end
	button.MouseButton1Click:Connect(function()
		setter(not getter())
		refresh()
	end)
	refresh()
	return refresh
end

