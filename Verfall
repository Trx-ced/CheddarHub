setPlayerESPEnabled = function(enabled)
	Config.PlayerESPEnabled = enabled
	for model, label in pairs(activeBillboards) do
		local billboard = label.Parent
		if billboard then
			billboard.Enabled = enabled
		end
	end
	if enabled then
		scanPlayerESP()
	else
		clearPlayerESP()
	end
end

startPlayerESP = function()
	if PlayerESPStarted then
		return
	end

	PlayerESPStarted = true
	CharactersFolder.ChildAdded:Connect(setupModelESP)
	CharactersFolder.ChildRemoved:Connect(function(child)
		activeBillboards[child] = nil
	end)
	scanPlayerESP()

	task.spawn(function()
		while true do
			task.wait(PLAYER_ESP_REFRESH_RATE)
			scanESPFrameworkPlayers()

			if not Config.PlayerESPEnabled then
				continue
			end

			local localChar = localPlayer.Character or workspace:FindFirstChild(localPlayer.Name)
			local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
			if not localRoot then
				continue
			end
			local localPos = localRoot.Position

			for model, textLabel in pairs(activeBillboards) do
				local root = model:FindFirstChild("HumanoidRootPart")
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				local billboard = textLabel.Parent

				if root and humanoid and humanoid.Health > 0 and billboard then
					local distance = math.round((root.Position - localPos).Magnitude)
					if distance > Config.PlayerESPMaxDistance then
						billboard.Enabled = false
						continue
					end

					billboard.Enabled = true
					local data = cachedPlayerData[model.Name]
					local branch = data and data.Branch or "No Branch"
					local loreName = data and data.LoreName or "Unknown"
					local health = math.round(humanoid.Health)

					textLabel.Text = string.format("%s | %s | HP: %d | %dstuds | %s", model.Name, loreName, health, distance, branch)

					local modTag = billboard:FindFirstChild("ModTag")
					if branch == "Staff Team" then
						textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
						if modTag then
							modTag.Visible = true
						end
					else
						textLabel.TextColor3 = getESPHealthColor(humanoid)
						if modTag then
							modTag.Visible = false
						end
					end
				elseif billboard then
					billboard.Enabled = false
				end
			end
		end
	end)
end

