							if not Config.MeleeHitMultiplierEnabled then
								return originalOnHit(self, p32, p33, p34)
							end
							for _ = 1, math.floor(math.clamp(tonumber(Config.MeleeHitMultiplier) or 1, 1, 5)) do
								task.spawn(function()
									originalOnHit(self, p32, p33, p34)
								end)
							end
						end
						hooked = true
					end
				end
			end
		end)
		if installed and hooked then
			Config.CombatHitMultiplierHooked = true
		end
	end

	if not Config.GunFrameworkModified then
		local installed = pcall(function()
			local clientFramework = ReplicatedStorage:FindFirstChild("ClientFramework")
			if clientFramework then
				local classes = clientFramework:WaitForChild("Classes", 5)
				local gunClassFile = classes and classes:FindFirstChild("GunClass")
				if gunClassFile then
					local success, gunClass = pcall(require, gunClassFile)
					if success and gunClass then
						if type(gunClass.RegisterHit) == "function" then
							local originalRegisterHit = gunClass.RegisterHit
							gunClass.RegisterHit = function(self, raycastResult, targetHumanoid, ...)
								local originalDamage = self.Damage
								local originalHeadDamage = self.HeadDamage
								if Config.DamageMultiplierEnabled then
									if type(originalDamage) == "number" then
										self.Damage = originalDamage * Config.DamageMultiplier
									end
									if type(originalHeadDamage) == "number" then
										self.HeadDamage = originalHeadDamage * Config.DamageMultiplier
									end
								end
								local results = table.pack(pcall(originalRegisterHit, self, raycastResult, targetHumanoid, ...))
								self.Damage = originalDamage
								self.HeadDamage = originalHeadDamage
								if not results[1] then
									error(results[2])
								end
								return unpack(results, 2, results.n)
							end
						end
						if type(gunClass.RecoilFunction) == "function" then
							local originalRecoil = gunClass.RecoilFunction
							gunClass.RecoilFunction = function(self, ...)
								if Config.NoRecoilEnabled then
									if self.Connections and self.Connections.Recoil then
										self.Connections.Recoil:Disconnect()
										self.Connections.Recoil = nil
									end
									if self.RecoilSpring then
										self.RecoilSpring:Reset()
									end
									if self.RecoilVignette then
										self.RecoilVignette.ImageTransparency = 1
									end
									local lightingBlur = game.Lighting:FindFirstChildOfClass("BlurEffect")
									if lightingBlur then
										lightingBlur.Size = 0
									end
									return
								end
								return originalRecoil(self, ...)
							end
						end
					end
				end
			end
		end)
		if installed then
			Config.GunFrameworkModified = true
		end
	end
end)

