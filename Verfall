local function getBandageRemovalData()
	if bandageRemovalData then
		return bandageRemovalData
	end

	local success, clientFramework = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientFramework", 5))
	end)

	if not success or not clientFramework then
		return nil
	end

