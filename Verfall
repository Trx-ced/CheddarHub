if not Config.BandageTalentHooked then
	task.spawn(function()
		local clientFramework = ReplicatedStorage:FindFirstChild("ClientFramework")
		if clientFramework then
			local success, frameworkModule = pcall(require, clientFramework)
			if success and frameworkModule and type(frameworkModule.PlayerHasTalent) == "function" then
				local oldPlayerHasTalent = frameworkModule.PlayerHasTalent
				local function replacement(player, talentName, ...)
					if Config.BandageEnabled and player == localPlayer and talentName == "Path of The Savior" then
						return true
					end
					if Config.BandageRemovalEnabled and player == localPlayer and talentName == "Path Of The Saviour" then
						return true
					end
					return oldPlayerHasTalent(player, talentName, ...)
				end
				local assigned = pcall(function()
					frameworkModule.PlayerHasTalent = replacement
				end)
				if not assigned and hookfunction then
					assigned = pcall(function()
						hookfunction(frameworkModule.PlayerHasTalent, replacement)
					end)
				end
				if assigned then
					Config.BandageTalentHooked = true
				end
			end
		end
	end)
end

if not Config.BandageNetworkHooked then
	Config.BandageNetworkHooked = true
	local oldNameCall
	oldNameCall = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		local args = { ... }
		if Config.BandageEnabled and (method == "FireServer" or method == "InvokeServer") and self.Name == "Bandage" then
			if args[1] == "SelfHeal" and type(args[3]) == "number" then
				args[3] = Config.SelfHealAmount
				return self[method](self, unpack(args))
			end
			if args[1] == "HealOther" and type(args[3]) == "number" then
				args[3] = Config.OtherHealAmount
				return self[method](self, unpack(args))
			end
		end
		return oldNameCall(self, ...)
	end)
end

if not Config.BandageRemovalHooksActive then
	local installed = pcall(function()
		local oldGetRemovalAttribute
		oldGetRemovalAttribute = hookfunction(Instance.new("Folder").GetAttribute, function(self, attributeName)
			if Config.BandageRemovalEnabled then
				local callingScript = getcallingscript and getcallingscript()
				local scriptName = callingScript and callingScript.Name or ""
				if attributeName == "Bandageable" then
					return true
				end
				if attributeName == "BandageCount" then
					if string.find(scriptName, "Bandage") and not string.find(scriptName, "Removal") then
						return 0
					end
					if string.find(scriptName, "Removal") or string.find(scriptName, "ToolsClient") then
						return 1
					end
				end
			end
			return oldGetRemovalAttribute(self, attributeName)
		end)

		local oldHasTag
		oldHasTag = hookfunction(CollectionService.HasTag, function(self, instance, tag)
			if Config.BandageRemovalEnabled and tag == "Reclusive" then
				return false
			end
			return oldHasTag(self, instance, tag)
		end)

		task.spawn(function()
			while task.wait(0.2) do
				if Config.BandageRemovalEnabled then
					local containers = {
						localPlayer:FindFirstChildOfClass("Backpack"),
						localPlayer.Character,
					}
					for _, container in ipairs(containers) do
						if container then
							local bandage = container:FindFirstChild("Bandage")
							if bandage and not bandage.Enabled then
								bandage.Enabled = true
							end
							local bandageRemoval = container:FindFirstChild("Bandage Removal")
							if bandageRemoval and not bandageRemoval.Enabled then
								bandageRemoval.Enabled = true
							end
						end
					end
				end
			end
		end)
	end)
	if installed then
		Config.BandageRemovalHooksActive = true
	end
end

