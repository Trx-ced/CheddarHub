	main.Visible = open
end

closeButton.MouseButton1Click:Connect(function()
	setWindowOpen(false)
end)

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		state.Dragging = true
		state.DragStart = input.Position
		state.StartPosition = main.Position
		state.DragDelta = Vector3.zero
		state.DragDirty = false
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				state.Dragging = false
				state.DragDirty = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if state.Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		state.DragDelta = input.Position - state.DragStart
		state.DragDirty = true
	end
end)

RunService.RenderStepped:Connect(function()
	if state.Dragging and state.DragDirty and state.StartPosition then
		local delta = state.DragDelta
		main.Position = UDim2.new(
			state.StartPosition.X.Scale,
			state.StartPosition.X.Offset + delta.X,
			state.StartPosition.Y.Scale,
			state.StartPosition.Y.Offset + delta.Y
		)
		state.DragDirty = false
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if state.Capturing and input.UserInputType == Enum.UserInputType.Keyboard then
		local setter = state.CaptureSetter
		local refresh = state.CaptureRefresh
		state.Capturing = nil
		state.CaptureSetter = nil
		state.CaptureRefresh = nil
		if setter then
			setter(input.KeyCode)
			SaveConfig()
		end
		if refresh then
			refresh()
		end
		refreshToggleBind()
		refreshRefillBind()
		refreshRawBandageBind()
		refreshBandageRemovalBind()
		refreshPlayerESPBind()
		return
	end

	if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	if input.KeyCode == Config.ToggleUIKey then
		setWindowOpen(not state.Open)
	elseif input.KeyCode == Config.RefillKey then
		instantRefillAll()
	elseif input.KeyCode == Config.RawBandageKey then
		fireRawBandageHeal()
	elseif input.KeyCode == Config.BandageRemovalMacroKey then
		task.spawn(executeBandageRemoval)
	elseif input.KeyCode == Config.PlayerESPKey then
		setPlayerESPEnabled(not Config.PlayerESPEnabled)
		refreshConfigControls()
		SaveConfig()
	end
end)

