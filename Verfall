if not Config.BandageNetworkHooked then
	Config.BandageNetworkHooked = true
	local oldNameCall
	oldNameCall = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		local args = { ... }
		if Config.BandageEnabled and (method == "FireServer" or method == "InvokeServer") and self.Name == "Bandage" then
			if args[1] == "SelfHeal" and type(args[3]) == "number" then
				args[3] = Config.SelfHealAmount
				return self[method](self, unpack(args))
			end
			if args[1] == "HealOther" and type(args[3]) == "number" then
				args[3] = Config.OtherHealAmount
				return self[method](self, unpack(args))
			end
		end
		return oldNameCall(self, ...)
	end)
end

local function instantRefillAll()
	for _, obj in pairs(getgc(true)) do
		if type(obj) == "table" then
			if obj.MaxGas and rawget(obj, "Gas") then
				obj.Gas = obj.MaxGas
				if type(obj.UpdateGas) == "function" then
					obj:UpdateGas()
				end
			end
			if obj.MaxDurability and rawget(obj, "Blades") then
				obj.Blades = obj.MaxBlades or 5
				obj.Durability = obj.MaxDurability
				if type(obj.UpdateDurability) == "function" then
					obj:UpdateDurability()
				end
			end
		end
	end
end

local function disableFallDamageLoop()
	for _, object in pairs(getgc(false)) do
		if type(object) == "function" then
			local success, info = pcall(debug.getinfo, object)
			if success and info and (info.name == "Deconnexions" or (info.source and string.find(info.source, "FallDamage"))) then
				local bypassed = pcall(object)
				if bypassed then
					return true
				end
			end
		end
	end
	return false
end

if Config.NoFallDamageEnabled then
	task.spawn(disableFallDamageLoop)
end

RunService.Heartbeat:Connect(function()
	if not Config.VelocityCapperEnabled then
		return
	end

	local character = localPlayer.Character
	if not character then
		return
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end

	local currentMaxCap = tonumber(Config.CustomStats and Config.CustomStats.OdmVeloCap) or 500
	if currentMaxCap <= 0 then
		return
	end

	local realVelocity = rootPart.AssemblyLinearVelocity
	if realVelocity.Magnitude > currentMaxCap then
		local clampedReal = realVelocity.Unit * currentMaxCap
		rootPart.AssemblyLinearVelocity = Vector3.new(clampedReal.X, realVelocity.Y, clampedReal.Z)
	end

	for _, mover in ipairs(character:GetDescendants()) do
		if mover:IsA("BodyVelocity") then
			local targetVelocity = mover.Velocity
			if targetVelocity.Magnitude > currentMaxCap then
				local clampedVelocity = targetVelocity.Unit * currentMaxCap
				mover.Velocity = Vector3.new(clampedVelocity.X, targetVelocity.Y, clampedVelocity.Z)
			end
		elseif mover:IsA("LinearVelocity") then
			local targetVelocity = mover.VectorVelocity
			if targetVelocity.Magnitude > currentMaxCap then
				local clampedVelocity = targetVelocity.Unit * currentMaxCap
				mover.VectorVelocity = Vector3.new(clampedVelocity.X, targetVelocity.Y, clampedVelocity.Z)
			end
		end
	end
end)

