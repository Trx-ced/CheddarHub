local function applyTitanDummy(dummy)
	if not dummy or not dummy.Parent then
		return
	end
	local nape = getTitanDummyNape(dummy)
	if not nape then
		return
	end
	if not titanDummyOriginals[nape] then
		titanDummyOriginals[nape] = {
			Size = nape.Size,
			CanCollide = nape.CanCollide,
			Transparency = nape.Transparency,
		}
	end
	local highlight = dummy:FindFirstChild("TitanDummyHighlight")
	if Config.TitanDummyShowEnabled then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "TitanDummyHighlight"
			highlight.Adornee = dummy
			highlight.FillColor = Color3.fromRGB(255, 60, 60)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.5
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = dummy
		end
	elseif highlight then
		highlight:Destroy()
	end
	if Config.TitanDummyHitboxEnabled then
		nape.Size = Config.TitanDummyHitboxSize
		nape.CanCollide = false
		nape.Transparency = 0.6
	else
		local original = titanDummyOriginals[nape]
		if original then
			nape.Size = original.Size
			nape.CanCollide = original.CanCollide
			nape.Transparency = original.Transparency
		end
	end
	local label = ensureTitanDummyUI(nape)
	updateTitanDummyLabel(dummy, label)
	if not titanDummyConnections[dummy] then
		titanDummyConnections[dummy] = dummy:GetAttributeChangedSignal("Hit"):Connect(function()
			local activeLabel = ensureTitanDummyUI(nape)
			if dummy:GetAttribute("Hit") == true and activeLabel and Config.TitanDummyCountdownEnabled then
				task.spawn(function()
					for i = 15, 1, -1 do
						if not activeLabel or not dummy.Parent or not Config.TitanDummyCountdownEnabled or not Config.TitanDummyStatusEnabled then
							break
						end
						activeLabel.Text = "DEAD\n" .. i .. "s"
						activeLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
						task.wait(1)
					end
					if activeLabel and dummy.Parent and Config.TitanDummyStatusEnabled then
						activeLabel.Text = "ALIVE"
						activeLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
					end
				end)
			else
				updateTitanDummyLabel(dummy, activeLabel)
			end
		end)
		dummy.Destroying:Connect(function()
			if titanDummyConnections[dummy] then
				titanDummyConnections[dummy]:Disconnect()
				titanDummyConnections[dummy] = nil
			end
		end)
	end
end

