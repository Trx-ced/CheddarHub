	end
end

local function createPlayerESP(characterModel)
	if not Config.PlayerESPEnabled then
		removePlayerESP(characterModel)
		return
	end

	if not characterModel or not characterModel:IsA("Model") or characterModel == localPlayer.Character then
		return
	end

	if characterModel:FindFirstChild("DevESP_UI", true) then
		return
	end

	local head = characterModel:FindFirstChild("Head")
	if not head then
		return
	end

	local bGui = Instance.new("BillboardGui")
	bGui.Name = "DevESP_UI"
	bGui.Size = UDim2.new(0, 250, 0, 50)
	bGui.AlwaysOnTop = true
	bGui.StudsOffset = Vector3.new(0, 3, 0)
	bGui.Adornee = head
	bGui.Enabled = true

	local label = Instance.new("TextLabel")
	label.Name = "ESPLabel"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextSize = 14
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Text = "Loading..."
	label.Parent = bGui

	bGui.Parent = head
end

local function updatePlayerESP(characterModel)
	if not Config.PlayerESPEnabled then
		removePlayerESP(characterModel)
		return
	end

	local myCharacter = localPlayer.Character
	if not characterModel or not characterModel:IsA("Model") or characterModel == myCharacter then
		return
	end

	createPlayerESP(characterModel)

	local myHrp = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
	local humanoid = characterModel:FindFirstChildOfClass("Humanoid")
	local hrp = characterModel:FindFirstChild("HumanoidRootPart")
	local bGui = characterModel:FindFirstChild("DevESP_UI", true)
	local label = bGui and bGui:FindFirstChild("ESPLabel")

	if label and humanoid and hrp then
		local distance = 0
		if myHrp then
			distance = math.floor((hrp.Position - myHrp.Position).Magnitude)
		end

		local health = math.max(0, math.floor(humanoid.Health))
		label.Text = string.format("%s | HP: %d | %ds", characterModel.Name, health, distance)
	end
end

local function clearPlayerESP()
	if not TARGET_ESP_FOLDER then
		return
	end

	for _, character in ipairs(TARGET_ESP_FOLDER:GetChildren()) do
		removePlayerESP(character)
	end
end

local function scanPlayerESP()
	if not TARGET_ESP_FOLDER then
		return
	end

	for _, character in ipairs(TARGET_ESP_FOLDER:GetChildren()) do
		task.spawn(updatePlayerESP, character)
	end
end

local function startPlayerESP()
	if PlayerESPStarted or not TARGET_ESP_FOLDER then
		return
	end

	PlayerESPStarted = true
	RunService.RenderStepped:Connect(function()
		if not Config.PlayerESPEnabled then
			return
		end

		for _, character in ipairs(TARGET_ESP_FOLDER:GetChildren()) do
			task.spawn(updatePlayerESP, character)
		end
	end)

	TARGET_ESP_FOLDER.ChildRemoving:Connect(function(child)
		removePlayerESP(child)
	end)

	TARGET_ESP_FOLDER.ChildAdded:Connect(function(child)
		task.delay(0.5, function()
			updatePlayerESP(child)
		end)
	end)
end

