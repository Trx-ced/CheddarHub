local function applyConfigEffects()
	if Config.NapeEnabled or Config.EyeEnabled then
		for _, titan in ipairs(TitansFolder:GetChildren()) do
			task.spawn(applyTitanExpansion, titan)
		end
	end

	if Config.NullifyEnabled then
		for _, titan in ipairs(TitansFolder:GetChildren()) do
			task.spawn(optimizeTitanNullify, titan)
		end
	end

	if Config.BandageEnabled and localPlayer.Character then
		localPlayer.Character:SetAttribute("BandageCount", 1)
	end

	if Config.NoFallDamageEnabled then
		task.spawn(disableFallDamageLoop)
	end

	if Config.TemperatureNullifierEnabled then
		installTemperatureNullifier()
	end

	if Config.MusketBullseyeEnabled then
		updateMusketBullseyes()
	end

	if Config.TitanDummyHitboxEnabled or Config.TitanDummyCountdownEnabled or Config.TitanDummyStatusEnabled or Config.TitanDummyShowEnabled then
		updateTitanDummies()
	end

	if Config.BladeModsEnabled then
		task.spawn(installBladeMods)
	end

	if Config.NoTalentCooldownEnabled then
		startNoTalentCooldownLoop()
	end

	if setPlayerESPEnabled then
		setPlayerESPEnabled(Config.PlayerESPEnabled == true)
	end
end

