local function updateNullifier()
	if not SETTINGS.NullifierEnabled then
		return
	end

	character = getCharacter()
	if not character then
		return
	end

	if not grabbedValue or not grabbedValue.Parent or grabbedValue.Parent ~= character then
		createGrabbed()
	else
		grabbedValue.Value = true
	end

	ensureBool("BeingGrabbed")
	ensureBool("TitanGrabbed")
	ensureFolder("CantBeGrabbed")
	ensureFolder("TitanGrabImmune")

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.Sit = false
		humanoid.AutoRotate = true
	end
end

local function setNullifierEnabled(state)
	SETTINGS.NullifierEnabled = state

	if state then
		character = getCharacter()
		grabbedValue = nil
		createGrabbed()

		if not nullifierConnection then
			nullifierConnection = RunService.RenderStepped:Connect(updateNullifier)
		end
	elseif nullifierConnection then
		nullifierConnection:Disconnect()
		nullifierConnection = nil
	end
end

local function updateExpanderPart(part)
	if not part or not part.Parent or not part:IsA("BasePart") then
		return
	end

	pcall(function()
		local size = SETTINGS.Expander.Size
		part.Size = Vector3.new(size, size, size)
		part.CanCollide = false
		part.Transparency = SETTINGS.Expander.Enabled and 0.5 or 1
		part.Material = Enum.Material.Neon
		part.BrickColor = BrickColor.new("Bright red")

		local box = part:FindFirstChild("HitboxBox")
		if not box then
			box = Instance.new("SelectionBox")
			box.Name = "HitboxBox"
			box.Adornee = part
			box.LineThickness = 0.05
			box.Color3 = Color3.new(1, 0, 0)
			box.Parent = part
		end

		box.Transparency = SETTINGS.Expander.Enabled and 0.5 or 1
		box.Visible = SETTINGS.Expander.Enabled
	end)
end

local function scanExpanders()
	local characters = Workspace:FindFirstChild("Characters")
	if not characters then
		return
	end

	for _, model in ipairs(characters:GetChildren()) do
		if model:IsA("Model") then
			local nape = model:FindFirstChild("NapeHB")
			local handle = nape and nape:FindFirstChild("Handle")

			if handle and handle:IsA("BasePart") then
				expanderParts[handle] = true
				updateExpanderPart(handle)
			end
		end
	end

	for part in pairs(expanderParts) do
		if part and part.Parent then
			updateExpanderPart(part)
		else
			expanderParts[part] = nil
		end
	end
end

local function setExpanderEnabled(state)
	SETTINGS.Expander.Enabled = state

	if state then
		scanExpanders()
		if not expanderConnection then
			expanderConnection = RunService.Heartbeat:Connect(function()
				if os.clock() - lastExpanderScan >= 0.3 then
					lastExpanderScan = os.clock()
					scanExpanders()
				end
			end)
		end
	elseif expanderConnection then
		expanderConnection:Disconnect()
		expanderConnection = nil

		for part in pairs(expanderParts) do
			if part and part.Parent then
				local box = part:FindFirstChild("HitboxBox")
				if box then
					box.Visible = false
				end
				part.Transparency = 1
			end
		end
	end
end

local function getGearVariants()
	local odmgStats = ReplicatedStorage:WaitForChild("ODMGStats")
	return require(odmgStats:WaitForChild("GearVariants"))
end

local function cacheOriginalGear(name, gear)
	if originalGearValues[name] then
		return
	end

	originalGearValues[name] = {
		VeloCap = gear.VeloCap,
		TurnSpeed = gear.TurnSpeed,
		DexDrain = gear.DexDrain,
		StartVelocity = gear.StartVelocity,
		VelocityGain = gear.VelocityGain,
	}
end

local function getHookActive(stats)
	if not stats then
		return false
	end

	local hooking = stats:FindFirstChild("Hooking")
	return hooking and hooking.Value == true
end

local function applyLiveGearRuntime()
	if not SETTINGS.Gear.Applied then
		return
	end

	local char = getCharacter()
	if not char then
		return
	end

	local stats = char:FindFirstChild("ODMGStats")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not stats or not root then
		return
	end

	local currentVelocity = stats:FindFirstChild("CurrentVelocity")
	local force = stats:FindFirstChild("Force")
	local hookActive = getHookActive(stats)
	local hookForce = root:FindFirstChild("HookDirectionalForce")

	if SETTINGS.Gear.VeloCapEnabled then
		local cap = SETTINGS.Gear.VeloCap

		if currentVelocity and currentVelocity:IsA("ValueBase") and hookActive and hookForce and currentVelocity.Value < cap then
			currentVelocity.Value = cap
		elseif currentVelocity and currentVelocity:IsA("ValueBase") and currentVelocity.Value > cap then
			currentVelocity.Value = cap
		end

		if force and force:IsA("ValueBase") and hookActive and hookForce and force.Value < cap then
			force.Value = cap
		elseif force and force:IsA("ValueBase") and force.Value > cap then
			force.Value = cap
		end

		if hookActive and hookForce and hookForce:IsA("BodyVelocity") then
			local velocity = hookForce.Velocity
			local magnitude = velocity.Magnitude

			if magnitude > 0 then
				local targetVelocity = velocity.Unit * cap
				hookForce.Velocity = targetVelocity
				root.AssemblyLinearVelocity = targetVelocity
			end
		end
	end
end

local function startGearRuntime()
	if gearRuntimeConnection then
		return
	end

	RunService:BindToRenderStep("CheddarCheeseGearRuntime", Enum.RenderPriority.Last.Value + 100, applyLiveGearRuntime)
	gearRuntimeConnection = true
end

local function stopGearRuntime()
	if gearRuntimeConnection then
		RunService:UnbindFromRenderStep("CheddarCheeseGearRuntime")
		gearRuntimeConnection = nil
	end
end

local function applyGearBoost()
	local gearVariants = getGearVariants()

	for gearName, gear in pairs(gearVariants) do
		if type(gear) == "table" then
			cacheOriginalGear(gearName, gear)

			local original = originalGearValues[gearName]
			gear.VeloCap = SETTINGS.Gear.VeloCapEnabled and SETTINGS.Gear.VeloCap or original.VeloCap
			gear.TurnSpeed = SETTINGS.Gear.TurnSpeedEnabled and original.TurnSpeed * SETTINGS.Gear.TurnSpeedMultiplier or original.TurnSpeed
			gear.DexDrain = SETTINGS.Gear.DexDrainEnabled and original.DexDrain / SETTINGS.Gear.DexDrainDivisor or original.DexDrain
			gear.StartVelocity = SETTINGS.Gear.StartVelocityEnabled and original.StartVelocity * SETTINGS.Gear.StartVelocityMultiplier or original.StartVelocity
			gear.VelocityGain = SETTINGS.Gear.VelocityGainEnabled and original.VelocityGain * SETTINGS.Gear.VelocityGainMultiplier or original.VelocityGain
		end
	end

	SETTINGS.Gear.Applied = true
	startGearRuntime()
end

local function resetGearBoost()
	local gearVariants = getGearVariants()

	for gearName, original in pairs(originalGearValues) do
		local gear = gearVariants[gearName]
		if type(gear) == "table" then
			gear.VeloCap = original.VeloCap
			gear.TurnSpeed = original.TurnSpeed
			gear.DexDrain = original.DexDrain
			gear.StartVelocity = original.StartVelocity
			gear.VelocityGain = original.VelocityGain
		end
	end

	SETTINGS.Gear.Applied = false
	stopGearRuntime()
end

local function refillGearData()
	local data = getDataFolder()
	if not data then
		return false
	end

	if refillDurabilityBox then
		SETTINGS.Gear.BladesDurability = numberOr(SETTINGS.Gear.BladesDurability, refillDurabilityBox.Text)
	end

	local changed = false
	changed = setDataValue(data, "MaxDurability", SETTINGS.Gear.BladesDurability) or changed
	changed = setDataValue(data, "Blades", SETTINGS.Gear.Blades) or changed
	changed = setDataValue(data, "Gas", SETTINGS.Gear.Gas) or changed
	changed = setDataValue(data, "Gas2", SETTINGS.Gear.Gas2) or changed
	task.wait(0.5)
	changed = setDataValue(data, "BladeDurability", SETTINGS.Gear.BladesDurability) or changed
	return changed
end

local function applyAttributes()
	local data = getDataFolder()
	if not data then
		return false
	end

	setDataValue(data, "Acceleration", SETTINGS.Attributes.Acceleration)
	setDataValue(data, "Strength", SETTINGS.Attributes.Strength)
	setDataValue(data, "Precision", SETTINGS.Attributes.Precision)
	return true
end

