local function createToggle(parent, y, text, getter, setter)
	createLabel(parent, y, text)
	local button = mk("TextButton", {
		Parent = parent,
		Position = UDim2.new(1, -100, 0, y - 4),
		Size = UDim2.new(0, 80, 0, 28),
		BackgroundColor3 = getter() and COLORS.ON or COLORS.OFF,
		BorderSizePixel = 0,
		Text = getter() and "ON" or "OFF",
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
	})
	addCorner(button, 9)
	addStroke(button, COLORS.STROKE, 1, 0.2)

	local function refresh()
		button.Text = getter() and "ON" or "OFF"
		TweenService:Create(button, TweenInfo.new(0.15), {
			BackgroundColor3 = getter() and COLORS.ON or COLORS.OFF,
		}):Play()
	end

	button.MouseButton1Click:Connect(function()
		setter(not getter())
		refresh()
	end)

	refresh()
	return button, refresh
end

local function createBox(parent, y, text, defaultValue, applyFn)
	createLabel(parent, y, text)
	local box = mk("TextBox", {
		Parent = parent,
		Position = UDim2.new(0, 16, 0, y + 22),
		Size = UDim2.new(1, -128, 0, 32),
		BackgroundColor3 = COLORS.INPUT,
		BorderSizePixel = 0,
		Text = tostring(defaultValue),
		TextColor3 = COLORS.TEXT,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		TextSize = 13,
	})
	addCorner(box, 10)
	addStroke(box, COLORS.STROKE_SOFT, 1, 0.1)

	local btn = mk("TextButton", {
		Parent = parent,
		Position = UDim2.new(1, -96, 0, y + 22),
		Size = UDim2.new(0, 80, 0, 32),
		BackgroundColor3 = COLORS.ACCENT,
		BorderSizePixel = 0,
		Text = "APPLY",
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
	})
	addCorner(btn, 10)
	addStroke(btn, COLORS.STROKE, 1, 0.14)

	btn.MouseButton1Click:Connect(function()
		applyFn(box.Text)
	end)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			applyFn(box.Text)
		end
	end)
	return box, btn
end

local function createOptionBox(parent, y, text, defaultValue, getEnabled, setEnabled, applyFn)
	local row = mk("Frame", {
		Parent = parent,
		Position = UDim2.new(0, 16, 0, y),
		Size = UDim2.new(1, -32, 0, 70),
		BackgroundColor3 = COLORS.INPUT,
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
	})
	addCorner(row, 12)
	addStroke(row, COLORS.STROKE_SOFT, 1, 0.35)

	mk("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 16),
		Text = text,
		TextColor3 = COLORS.SUB,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham,
		TextSize = 12,
	})

	local toggle = mk("TextButton", {
		Parent = row,
		Position = UDim2.new(1, -176, 0, 30),
		Size = UDim2.new(0, 76, 0, 30),
		BackgroundColor3 = getEnabled() and COLORS.ON or COLORS.OFF,
		BorderSizePixel = 0,
		Text = getEnabled() and "ON" or "OFF",
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
	})
	addCorner(toggle, 9)
	addStroke(toggle, COLORS.STROKE, 1, 0.2)

	local box = mk("TextBox", {
		Parent = row,
		Position = UDim2.new(0, 12, 0, 30),
		Size = UDim2.new(1, -204, 0, 30),
		BackgroundColor3 = COLORS.INPUT,
		BorderSizePixel = 0,
		Text = tostring(defaultValue),
		TextColor3 = COLORS.TEXT,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		TextSize = 13,
	})
	addCorner(box, 10)
	addStroke(box, COLORS.STROKE_SOFT, 1, 0.1)

	local apply = mk("TextButton", {
		Parent = row,
		Position = UDim2.new(1, -92, 0, 30),
		Size = UDim2.new(0, 80, 0, 30),
		BackgroundColor3 = COLORS.ACCENT,
		BorderSizePixel = 0,
		Text = "APPLY",
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
	})
	addCorner(apply, 10)
	addStroke(apply, COLORS.STROKE, 1, 0.14)

	local function refreshToggle()
		toggle.Text = getEnabled() and "ON" or "OFF"
		TweenService:Create(toggle, TweenInfo.new(0.15), {
			BackgroundColor3 = getEnabled() and COLORS.ON or COLORS.OFF,
		}):Play()
	end

	toggle.MouseButton1Click:Connect(function()
		setEnabled(not getEnabled())
		refreshToggle()
	end)

	apply.MouseButton1Click:Connect(function()
		applyFn(box.Text)
	end)

	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			applyFn(box.Text)
		end
	end)

	refreshToggle()
	return box, toggle, apply
end

local function createKeybindRow(parent, y, labelText, getter, setter)
	createLabel(parent, y, labelText)
	local button = mk("TextButton", {
		Parent = parent,
		Position = UDim2.new(1, -156, 0, y - 4),
		Size = UDim2.new(0, 136, 0, 28),
		BackgroundColor3 = COLORS.OFF,
		BorderSizePixel = 0,
		Text = keyName(getter()),
		TextColor3 = COLORS.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
	})
	addCorner(button, 9)
	addStroke(button, COLORS.STROKE, 1, 0.2)

	local function refresh()
		if uiState.capturingKeybind == button then
			button.Text = "PRESS A KEY..."
			button.BackgroundColor3 = COLORS.ON
		else
			button.Text = keyName(getter())
			button.BackgroundColor3 = COLORS.OFF
		end
	end

	button.MouseButton1Click:Connect(function()
		uiState.capturingKeybind = button
		keybindSetters[button] = setter
		refresh()
	end)

	refresh()
	return button, refresh
end

