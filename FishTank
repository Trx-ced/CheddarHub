end

local function setDataValue(data, name, value)
	if not data then
		return false
	end

	local changed = false
	local obj = data:FindFirstChild(name)
	if not obj then
		obj = data:FindFirstChild(name, true)
	end

	if obj and obj:IsA("ValueBase") then
		obj.Value = value
		changed = true
	end

	if data:GetAttribute(name) ~= nil then
		data:SetAttribute(name, value)
		changed = true
	end

	return changed
end

local function createGrabbed()
	if not character then
		return
	end

	local existing = character:FindFirstChild("Grabbed")
	if existing and existing:IsA("BoolValue") then
		grabbedValue = existing
		grabbedValue.Value = true
		return
	end

	if existing then
		pcall(function()
			existing:Destroy()
		end)
	end

	local success, value = pcall(function()
		local grabbed = Instance.new("BoolValue")
		grabbed.Name = "Grabbed"
		grabbed.Value = true
		grabbed.Parent = character
		return grabbed
	end)

	if success then
		grabbedValue = value
		grabbedValue.AncestryChanged:Connect(function(_, parent)
			if SETTINGS.NullifierEnabled and parent == nil then
				task.defer(createGrabbed)
			end
		end)
	end
end

local function ensureBool(name)
