topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		uiState.dragging = true
		uiState.dragStart = input.Position
		uiState.startPos = main.Position
	end
end)

topBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		uiState.dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if uiState.dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - uiState.dragStart
		main.Position = UDim2.new(
			uiState.startPos.X.Scale,
			uiState.startPos.X.Offset + delta.X,
			uiState.startPos.Y.Scale,
			uiState.startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputBegan:Connect(function(input, typing)
	if typing then
		return
	end

	if uiState.capturingKeybind then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			local button = uiState.capturingKeybind
			local setter = keybindSetters[button]
			if setter then
				setter(input.KeyCode)
			end
			button.Text = keyName(input.KeyCode)
			button.BackgroundColor3 = COLORS.OFF
			uiState.capturingKeybind = nil
		end
		return
	end

	if input.KeyCode == SETTINGS.UiToggleKey then
		gui.Enabled = not gui.Enabled
	elseif input.KeyCode == SETTINGS.Gear.RefillKey then
		refillGearData()
	end
end)

