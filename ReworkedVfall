function setActiveTab(name)
	for pageName, tab in pairs(tabs) do
		local active = pageName == name
		tab.BackgroundColor3 = active and COLORS.TAB_ACTIVE or COLORS.TAB
		tab.TextColor3 = active and COLORS.TEXT or COLORS.SUB
	end
end

local function switchPage(name)
	searchBox.Text = ""
	for pageName, page in pairs(pages) do
		page.Visible = pageName == name
	end
	for _, record in ipairs(state.SearchRecords) do
		record.Card.Visible = true
	end
	setActiveTab(name)
	state.Page = name
end

function appendSearchText(card, text)
	if not card or not text then
		return
	end

	local record = state.CardRecords[card]
	if not record then
		return
	end

	record.SearchText = (record.SearchText .. " " .. tostring(text)):lower()
end

function applyFeatureSearch()
	if state.ApplyingSearch then
		return
	end
	state.ApplyingSearch = true

	local query = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
	if query == "" then
		for _, record in ipairs(state.SearchRecords) do
			record.Card.Visible = true
		end
		for pageName, page in pairs(pages) do
			page.Visible = pageName == state.Page
		end
		setActiveTab(state.Page)
		state.ApplyingSearch = false
		return
	end

	local firstPageName = nil
	for _, record in ipairs(state.SearchRecords) do
		local matched = record.SearchText:find(query, 1, true) ~= nil
		record.Card.Visible = matched
		if matched and not firstPageName then
			firstPageName = record.PageName
		end
	end

	for pageName, page in pairs(pages) do
		page.Visible = pageName == firstPageName
	end
	if firstPageName then
		setActiveTab(firstPageName)
	else
		setActiveTab(nil)
	end

	state.ApplyingSearch = false
end

