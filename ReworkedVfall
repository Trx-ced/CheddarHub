		if not Config.AttributesEnabled or Config.CustomStatsEnabled.ReloadSpeed ~= true then
			return
		end

		local value = tonumber(Config.CustomStats.ReloadSpeed)
		if not value or value <= 0 then
			return
		end

		if type(rawget(self, "ReloadSpeed")) == "number" then
			self.ReloadSpeed = value
		end
	end

	for _, methodName in ipairs({ "Reload", "StartReload", "ReloadWeapon" }) do
		if type(gunClass[methodName]) == "function" then
			local original = gunClass[methodName]
			gunClass[methodName] = function(self, ...)
				applyReloadSpeedFields(self)
				return original(self, ...)
			end
		end
	end

	gunClass.__CheddarReloadSpeedVersion = 1
end)

