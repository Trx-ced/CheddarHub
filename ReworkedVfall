state.UnloadHub = function()
	_G[RUN_ID_KEY] = (_G[RUN_ID_KEY] or CURRENT_RUN_ID) + 1
	applyDefaultDisabledConfig()
	Config.NoFogEnabled = false
	Config.BrightnessEnabled = false
	Config.FOVLockEnabled = false
	Config.PlayerESPEnabled = false
	Config.FOVEnabled = false
	Config.HideFOV = true
	Config.GearStatsEnabled = {}
	for statName in pairs(GEAR_STAT_VALUES) do
		Config.GearStatsEnabled[statName] = false
	end
	restoreOdmClassMods()

	restoreFog()
	restoreBrightness()
	restoreFOVLock()

	if setPlayerESPEnabled then
		pcall(setPlayerESPEnabled, false)
	end

	if fovCircle then
		pcall(function()
			fovCircle.Visible = false
			if fovCircle.Remove then
				fovCircle:Remove()
			elseif fovCircle.Destroy then
				fovCircle:Destroy()
			end
		end)
	end
	_G.CheddarHubFOVCircle = nil

	for _, connection in ipairs(_G[TRANSIENT_CONNECTIONS_KEY]) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	_G[TRANSIENT_CONNECTIONS_KEY] = {}

	pcall(function()
		gui:Destroy()
	end)
end

trackConnection(closeButton.MouseButton1Click:Connect(function()
	state.SetWindowOpen(false)
end))

trackConnection(topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		state.Dragging = true
		state.DragStart = input.Position
		state.StartPosition = main.Position
		state.DragDelta = Vector3.zero
		state.DragDirty = false
		trackConnection(input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				state.Dragging = false
				state.DragDirty = false
			end
		end))
	end
end))

trackTransientConnection(UserInputService.InputChanged:Connect(function(input)
	if state.Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		state.DragDelta = input.Position - state.DragStart
		state.DragDirty = true
	end
end))

trackTransientConnection(RunService.RenderStepped:Connect(function()
	if state.Dragging and state.DragDirty and state.StartPosition then
		local delta = state.DragDelta
		main.Position = UDim2.new(
			state.StartPosition.X.Scale,
			state.StartPosition.X.Offset + delta.X,
			state.StartPosition.Y.Scale,
			state.StartPosition.Y.Offset + delta.Y
		)
		state.DragDirty = false
	end
end))

trackTransientConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if state.Capturing and input.UserInputType == Enum.UserInputType.Keyboard then
		local setter = state.CaptureSetter
		local refresh = state.CaptureRefresh
		state.Capturing = nil
		state.CaptureSetter = nil
		state.CaptureRefresh = nil
		if setter then
			setter(input.KeyCode)
			SaveConfig()
		end
		if refresh then
			refresh()
		end
		if refreshToggleBind then refreshToggleBind() end
		if refreshPlayerESPBind then refreshPlayerESPBind() end
		return
	end

	if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	if input.KeyCode == Config.ToggleUIKey then
		state.SetWindowOpen(not state.Open)
	elseif IS_MAIN_HUB and input.KeyCode == Config.PlayerESPKey and setPlayerESPEnabled then
		setPlayerESPEnabled(not Config.PlayerESPEnabled)
		refreshConfigControls()
		SaveConfig()
	end
end))

switchPage(IS_MAIN_HUB and "Main" or "Misc")
