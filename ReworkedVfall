local function getESPFramework()
	if espClientFramework ~= nil then
		return espClientFramework
	end

	local success, framework = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientFramework"))
	end)

	if success and framework then
		espClientFramework = framework
		espGlobalTeams = framework.GlobalLibrary and framework.GlobalLibrary.Teams or {}
	else
		espClientFramework = false
	end

	return espClientFramework
end

local function cacheESPData(playerObject)
	if not playerObject then
		return
	end

	local firstName = playerObject:GetAttribute("FirstName") or ""
	local lastName = playerObject:GetAttribute("LastName") or ""
	local teamId = playerObject:GetAttribute("Team") or ""
	local branch = "No Branch"

	if teamId ~= "" then
		if espGlobalTeams[teamId] then
			branch = teamId
		else
			for teamName in pairs(espGlobalTeams) do
				if teamName == teamId then
					branch = teamName
					break
				end
			end
			if branch == "No Branch" then
				branch = teamId
			end
		end
	end

	local loreName = "Unknown"
	if firstName ~= "" or lastName ~= "" then
		loreName = string.format("%s %s", firstName, lastName):match("^%s*(.-)%s*$")
	end

	cachedPlayerData[playerObject.Name] = {
		LoreName = loreName,
		Branch = branch,
	}
end

local function monitorESPPlayer(playerObject)
	if monitoredESPPlayers[playerObject] then
		return
	end
	monitoredESPPlayers[playerObject] = true
	cacheESPData(playerObject)
	local function forgetESPPlayer()
		monitoredESPPlayers[playerObject] = nil
		cachedPlayerData[playerObject.Name] = nil
	end
	trackTransientConnection(playerObject:GetAttributeChangedSignal("Team"):Connect(function()
		cacheESPData(playerObject)
	end))
	trackTransientConnection(playerObject:GetAttributeChangedSignal("FirstName"):Connect(function()
		cacheESPData(playerObject)
	end))
	trackTransientConnection(playerObject:GetAttributeChangedSignal("LastName"):Connect(function()
		cacheESPData(playerObject)
	end))
	trackTransientConnection(playerObject.Destroying:Connect(forgetESPPlayer))
end

local function scanESPFrameworkPlayers()
	local framework = getESPFramework()
	if not framework or type(framework.GetPlayers) ~= "function" then
		return
	end

	local success, frameworkPlayers = pcall(function()
		return framework.GetPlayers()
	end)

	if success and type(frameworkPlayers) == "table" then
		for i = 1, #frameworkPlayers do
			local playerObject = frameworkPlayers[i]
			if playerObject and not cachedPlayerData[playerObject.Name] then
				monitorESPPlayer(playerObject)
			end
		end
	end
end

local function getESPHealthColor(humanoid)
	local maxHealth = humanoid.MaxHealth
	local currentHealth = humanoid.Health
	local percent = (maxHealth > 0) and (currentHealth / maxHealth) * 100 or 100

	if percent >= 70 then
		return Color3.fromRGB(0, 255, 120)
	elseif percent >= 40 then
		return Color3.fromRGB(255, 200, 0)
	elseif percent >= 20 then
		return Color3.fromRGB(255, 110, 0)
	end

	return Color3.fromRGB(255, 0, 50)
end

local function getLocalESPRoot()
	local character = localPlayer.Character or workspace:FindFirstChild(localPlayer.Name)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		return root
	end

	for _, folder in ipairs(getCharacterFolders()) do
		local model = folder:FindFirstChild(localPlayer.Name)
		root = model and model:FindFirstChild("HumanoidRootPart")
		if root then
			return root
		end
	end

	return nil
end

local function updateESPLabel(model, textLabel)
	if not model or not textLabel then
		return false
	end

	local root = model:FindFirstChild("HumanoidRootPart")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local billboard = textLabel.Parent
	if not model.Parent or not billboard then
		activeBillboards[model] = nil
		return false
	end

	if not root or not humanoid or humanoid.Health <= 0 then
		billboard.Enabled = false
		return false
	end

	local localRoot = getLocalESPRoot()
	local distance
	if localRoot then
		distance = math.round((root.Position - localRoot.Position).Magnitude)
		if distance > Config.PlayerESPMaxDistance then
			billboard.Enabled = false
			return false
		end
	end

	billboard.Enabled = Config.PlayerESPEnabled == true
	local data = cachedPlayerData[model.Name]
	local branch = data and data.Branch or "No Branch"
	local loreName = data and data.LoreName or "Unknown"
	local health = math.round(humanoid.Health)
	local distanceText = distance and (tostring(distance) .. "studs") or "?studs"
	textLabel.Text = string.format("%s | %s | HP: %d | %s | %s", model.Name, loreName, health, distanceText, branch)

	local modTag = billboard:FindFirstChild("ModTag")
	if branch == "Staff Team" then
		textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		if modTag then
			modTag.Visible = true
		end
	else
		textLabel.TextColor3 = getESPHealthColor(humanoid)
		if modTag then
			modTag.Visible = false
		end
	end

	return true
end

local function removePlayerESP(model)
	if not model then
		return
	end

	activeBillboards[model] = nil
	local root = model:FindFirstChild("HumanoidRootPart")
	local existing = root and root:FindFirstChild("StaffTrackerEspGui")
	if existing then
		existing:Destroy()
	end
end

local function setupModelESP(model)
	if not Config.PlayerESPEnabled or not model:IsA("Model") or model.Name == localPlayer.Name then
		return
	end

	local root = model:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return
	end

	for i = 1, #OLD_ESP_NAMES do
		local legacy = root:FindFirstChild(OLD_ESP_NAMES[i])
		if legacy then
			legacy:Destroy()
		end
	end

	local existingESP = root:FindFirstChild("StaffTrackerEspGui")
	if existingESP then
		local existingLabel = existingESP:FindFirstChild("EspText")
		if existingLabel then
			if existingLabel.Text == "" or existingLabel.Text == "Label" or existingLabel.Text == "Label1" then
				existingLabel.Text = model.Name
			end
			existingESP.Enabled = Config.PlayerESPEnabled
			activeBillboards[model] = existingLabel
			updateESPLabel(model, existingLabel)
		else
			existingESP:Destroy()
		end
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StaffTrackerEspGui"
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.new(0, 550, 0, 100)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.Adornee = root
	billboard.Enabled = Config.PlayerESPEnabled

	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "EspText"
	textLabel.Size = UDim2.new(1, 0, 0, 30)
	textLabel.Position = UDim2.new(0, 0, 0, 45)
	textLabel.BackgroundTransparency = 1
	textLabel.TextSize = PLAYER_ESP_TEXT_SIZE
	textLabel.Font = Enum.Font.RobotoMono
	textLabel.Text = model.Name
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextStrokeTransparency = 0.15
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Parent = billboard

	local modTag = Instance.new("TextLabel")
	modTag.Name = "ModTag"
	modTag.Size = UDim2.new(1, 0, 0, 40)
	modTag.Position = UDim2.new(0, 0, 0, 5)
	modTag.BackgroundTransparency = 1
	modTag.TextSize = 28
	modTag.Font = Enum.Font.RobotoMono
	modTag.TextColor3 = Color3.fromRGB(255, 255, 255)
	modTag.TextStrokeTransparency = 0.05
	modTag.TextStrokeColor3 = Color3.fromRGB(255, 0, 0)
	modTag.Text = "MODERATOR"
	modTag.Visible = false
	modTag.Parent = billboard

	billboard.Parent = root
	activeBillboards[model] = textLabel
	updateESPLabel(model, textLabel)
end

local function clearPlayerESP()
	for model in pairs(activeBillboards) do
		removePlayerESP(model)
	end

	for _, folder in ipairs(getCharacterFolders()) do
		for _, model in ipairs(folder:GetChildren()) do
			removePlayerESP(model)
		end
	end
end

local function scanPlayerESP()
	scanESPFrameworkPlayers()
	for _, folder in ipairs(getCharacterFolders()) do
		for _, model in ipairs(folder:GetChildren()) do
			task.spawn(setupModelESP, model)
		end
	end
end

setPlayerESPEnabled = function(enabled)
	Config.PlayerESPEnabled = enabled
	if not PlayerESPStarted and enabled then
		task.spawn(startPlayerESP)
	end
	for model, label in pairs(activeBillboards) do
		local billboard = label.Parent
		if billboard then
			billboard.Enabled = enabled
		end
	end
	if enabled then
		scanPlayerESP()
	else
		clearPlayerESP()
	end
end

startPlayerESP = function()
	if PlayerESPStarted then
		return
	end

	_G.CheddarESPRunId = (_G.CheddarESPRunId or 0) + 1
	_G.CheddarESPConnections = _G.CheddarESPConnections or {}
	for _, connection in ipairs(_G.CheddarESPConnections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	_G.CheddarESPConnections = {}
	local function trackESPConnection(connection)
		if connection then
			_G.CheddarESPConnections[#_G.CheddarESPConnections + 1] = connection
		end
		return connection
	end
	local espRunId = _G.CheddarESPRunId
	PlayerESPStarted = true
	trackESPConnection(CharactersFolder.ChildAdded:Connect(setupModelESP))
	trackESPConnection(CharactersFolder.ChildRemoved:Connect(function(child)
		activeBillboards[child] = nil
	end))
	scanPlayerESP()

	task.spawn(function()
		local lastFrameworkScan = 0
		local lastModelScan = 0
		while _G.CheddarESPRunId == espRunId do
			task.wait(math.max(tonumber(Config.PlayerESPUpdateRate) or PLAYER_ESP_REFRESH_RATE, 0.35))

			local now = os.clock()
			if now - lastFrameworkScan > 3 then
				lastFrameworkScan = now
				scanESPFrameworkPlayers()
			end

			if not Config.PlayerESPEnabled then
				continue
			end

			if now - lastModelScan > 1 then
				lastModelScan = now
				scanPlayerESP()
			end

			for model, textLabel in pairs(activeBillboards) do
				updateESPLabel(model, textLabel)
			end
		end
	end)
end

