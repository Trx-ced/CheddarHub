local ODM_CLASS_PATCH_KEY = "CheddarHubOdmClassPatch_" .. HUB_PROFILE
local ODM_NIL_SENTINEL = {}
local odmClassPatchInstalled = false
local odmClassInstanceOriginals = setmetatable({}, {__mode = "k"})

local function getGearOverride(statName)
	if Config.GearStatsEnabled[statName] == true then
		return tonumber(Config.GearStatValues[statName]) or GEAR_STAT_VALUES[statName]
	end
	return nil
end

local function restoreOdmClassMods()
	local patchState = _G[ODM_CLASS_PATCH_KEY]
	if patchState and patchState.Class then
		patchState.Class.__index = patchState.OriginalIndex
		for methodName, originalFunc in pairs(patchState.OriginalMethods or {}) do
			if patchState.Class[methodName] == (patchState.WrappedMethods and patchState.WrappedMethods[methodName]) then
				patchState.Class[methodName] = originalFunc
			end
		end
	end
	_G[ODM_CLASS_PATCH_KEY] = nil
	odmClassPatchInstalled = false
	odmClassInstanceOriginals = setmetatable({}, {__mode = "k"})
end

local function getOdmClass()
	local clientFramework = ReplicatedStorage:FindFirstChild("ClientFramework")
	local classes = clientFramework and clientFramework:FindFirstChild("Classes")
	local odmClassModule = classes and classes:FindFirstChild("OdmClass")
	if not odmClassModule or not odmClassModule:IsA("ModuleScript") then
		return nil
	end

	local ok, odmClass = pcall(require, odmClassModule)
	if ok and typeof(odmClass) == "table" then
		return odmClass
	end

	return nil
end

local function applyOdmStatsToInstance(self)
	if type(self) ~= "table" then
		return
	end

	local originalStats = odmClassInstanceOriginals[self]
	if not originalStats then
		originalStats = {}
		odmClassInstanceOriginals[self] = originalStats
	end

	for statName, defaultModifiedValue in pairs(GEAR_STAT_VALUES) do
		local overrideValue = getGearOverride(statName)
		if overrideValue ~= nil then
			if originalStats[statName] == nil then
				local currentValue = rawget(self, statName)
				originalStats[statName] = currentValue == nil and ODM_NIL_SENTINEL or currentValue
			end
			rawset(self, statName, overrideValue)
		elseif originalStats[statName] ~= nil then
			local originalValue = originalStats[statName]
			rawset(self, statName, originalValue == ODM_NIL_SENTINEL and nil or originalValue)
		end
	end
end

local function installOdmClassMods()
	if odmClassPatchInstalled and _G[ODM_CLASS_PATCH_KEY] then
		return true
	end

	restoreOdmClassMods()

	local OdmClass = getOdmClass()
	if not OdmClass then
		return false
	end

	local originalIndex = OdmClass.__index
	local patchState = {
		Class = OdmClass,
		OriginalIndex = originalIndex,
		OriginalMethods = {},
		WrappedMethods = {},
	}

	OdmClass.__index = function(self, key)
		local overrideValue = getGearOverride(key)
		if overrideValue ~= nil then
			return overrideValue
		end

		if type(originalIndex) == "function" then
			return originalIndex(self, key)
		elseif type(originalIndex) == "table" then
			return originalIndex[key]
		end

		return nil
	end

	for methodName, func in pairs(OdmClass) do
		if type(func) == "function" then
			patchState.OriginalMethods[methodName] = func
			local wrappedFunc = function(self, ...)
				applyOdmStatsToInstance(self)
				return func(self, ...)
			end
			patchState.WrappedMethods[methodName] = wrappedFunc
			OdmClass[methodName] = wrappedFunc
		end
	end

	_G[ODM_CLASS_PATCH_KEY] = patchState
	odmClassPatchInstalled = true
	return true
end

local function applyGearMods()
	if installOdmClassMods() then
		for instance in pairs(odmClassInstanceOriginals) do
			applyOdmStatsToInstance(instance)
		end
	end
end
