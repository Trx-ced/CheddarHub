local velocityCapMoverConnections = {}
local velocityCapCharacter = nil
local velocityCapMovers = setmetatable({}, { __mode = "k" })

local function getVelocityCap()
	return tonumber(Config.CustomStats and Config.CustomStats.OdmVeloCap) or 300
end

local function clampHorizontalVelocity(vector, maxCap)
	local horizontal = Vector3.new(vector.X, 0, vector.Z)
	if horizontal.Magnitude <= maxCap or maxCap <= 0 then
		return vector, false
	end

	local clamped = horizontal.Unit * maxCap
	return Vector3.new(clamped.X, vector.Y, clamped.Z), true
end

local function trackVelocityMover(instance)
	if not instance or velocityCapMovers[instance] then
		return
	end
	if instance:IsA("BodyVelocity") or instance:IsA("LinearVelocity") then
		velocityCapMovers[instance] = true
	end
end

local function rebuildVelocityCapWatch(character)
	for _, connection in ipairs(velocityCapMoverConnections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	velocityCapMoverConnections = {}
	velocityCapMovers = setmetatable({}, { __mode = "k" })
	velocityCapCharacter = character

	if not character then
		return
	end

	for _, descendant in ipairs(character:GetDescendants()) do
		trackVelocityMover(descendant)
	end
	velocityCapMoverConnections[#velocityCapMoverConnections + 1] = trackTransientConnection(character.DescendantAdded:Connect(trackVelocityMover))
end

local function applyVelocityCap()
	if not Config.VelocityCapperEnabled then
		return
	end

	local character = localPlayer.Character
	if character ~= velocityCapCharacter then
		rebuildVelocityCapWatch(character)
	end
	if not character then
		return
	end

	local currentMaxCap = getVelocityCap()
	if currentMaxCap <= 0 then
		return
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart then
		local clamped, changed = clampHorizontalVelocity(rootPart.AssemblyLinearVelocity, currentMaxCap)
		if changed then
			rootPart.AssemblyLinearVelocity = clamped
		end
	end

	for mover in pairs(velocityCapMovers) do
		if not mover.Parent then
			velocityCapMovers[mover] = nil
		elseif mover:IsA("BodyVelocity") then
			local clamped, changed = clampHorizontalVelocity(mover.Velocity, currentMaxCap)
			if changed then
				mover.Velocity = clamped
			end
		elseif mover:IsA("LinearVelocity") then
			local clamped, changed = clampHorizontalVelocity(mover.VectorVelocity, currentMaxCap)
			if changed then
				mover.VectorVelocity = clamped
			end
		end
	end
end

if IS_MAIN_HUB then
trackTransientConnection(RunService.Heartbeat:Connect(function()
	applyVelocityCap()
end))
end

