	end
end


local titanHitboxState = setmetatable({}, { __mode = "k" })

local function applyTitanExpansion(titanModel)
	if not titanModel:IsA("Model") then
		return
	end

	local damagePoints = titanModel:FindFirstChild("DamagePoints")
	local root = titanModel:FindFirstChild("HumanoidRootPart") or titanModel:FindFirstChild("Head")
	if not damagePoints or not root then
		return
	end

	local function configurePart(part, size, offset)
		if not part or not part:IsA("BasePart") then
			return
		end
		local existingWeld = part:FindFirstChild("CheddarHitboxWeld")
		local state = titanHitboxState[part]
		local originalSize = state and state.OriginalSize or part.Size
		if state and state.Root == root and state.Size == size and state.Offset == offset and existingWeld then
			return
		end
		for _, obj in ipairs(part:GetChildren()) do
			if obj:IsA("JointInstance") or obj:IsA("Weld") or obj.Name == "CheddarHitboxWeld" then
				obj:Destroy()
			end
		end
		part.Size = size
		part.CanCollide = false
		part.CFrame = root.CFrame * CFrame.new(offset)
		local weld = Instance.new("WeldConstraint")
		weld.Name = "CheddarHitboxWeld"
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		titanHitboxState[part] = {
			Root = root,
			Size = size,
			Offset = offset,
			OriginalSize = originalSize,
		}
	end

	if Config.NapeEnabled then
		local nape = damagePoints:FindFirstChild("Nape") or damagePoints:FindFirstChild("NapeHB") or titanModel:FindFirstChild("NapeHB", true)
		if nape then
			local state = titanHitboxState[nape]
			local baseSize = state and state.OriginalSize or nape.Size
